local function FindNearestCoin()

    if not RootPart then  
        return nil  
    end  

    local nearest = nil  
    local distance = math.huge  

    for _,obj in ipairs(workspace:GetDescendants()) do  

        if obj:IsA("BasePart") then  

            local name = string.lower(obj.Name)  

            if string.find(name,"coin")  
            or string.find(name,"cash")  
            or string.find(name,"money") then  

                local d =  
                    (RootPart.Position - obj.Position).Magnitude  

                if d < distance then  
                    distance = d  
                    nearest = obj  
                end  
            end  
        end  
    end  

    return nearest
end

task.spawn(function()

    while true do  

        task.wait(2)  

        if Config.AutoFarm and RootPart then  

            local coin = FindNearestCoin()  

            if coin then  

                RootPart.CFrame =  
                    coin.CFrame  
                    + Vector3.new(0,3,0)  

                CoinsCollected += 1  

                Counter.Text =  
                    "💰 Монет собрано: "..CoinsCollected  
            end  
        end  
    end
end)


