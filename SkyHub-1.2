    end
end

local function GetRoleColor(player)

    local role = player:GetAttribute("Role")  

    if role == "Murderer" or role == "Murder" then  
        return Color3.fromRGB(255,50,50)  
    elseif role == "Sheriff" then  
        return Color3.fromRGB(50,120,255)  
    else  
        return Color3.fromRGB(50,255,100)  
    end
end

local function UpdateESP()

    ClearESP()  

    if not Config.ESP then  
        return  
    end  

    for _,player in ipairs(Players:GetPlayers()) do  

        if player ~= LocalPlayer and player.Character then  

            local Highlight = Instance.new("Highlight")  
            Highlight.Name = "SkyHubESP"  
            Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop  
            Highlight.FillColor = GetRoleColor(player)  
            Highlight.FillTransparency = 0.55  
            Highlight.OutlineColor = GetRoleColor(player)  
            Highlight.Parent = player.Character  

            ESPObjects[player] = Highlight  
        end  
    end
end

