function setActiveTab(id)
    activeTab=id
    for k,data in pairs(tabContainers)do
        data.container.Visible=(k==id)
    end
    for k,btn in pairs(tabBtns)do
        if k==id then
            btn.BackgroundColor3=Color3.fromRGB(70,60,130)
            btn.TextColor3=Color3.new(1,1,1)
        else
            btn.BackgroundColor3=Color3.fromRGB(40,40,60)
            btn.TextColor3=Color3.new(0.8,0.8,0.9)
        end
    end
end

local function savePos()
    local my=LP.Character
    if my then
        local root=my:FindFirstChild("HumanoidRootPart") or my:FindFirstChild("Torso")
        if root then lobbyPos=root.CFrame end
    end
    local map=workspace:FindFirstChild("Map") or workspace:FindFirstChild("Baseplate")
    if map and map:IsA("BasePart") then
        mapPos=map.CFrame
    else
        for _,v in ipairs(workspace:GetDescendants())do
            if v:IsA("BasePart")and v.Size.Magnitude>20 then
                mapPos=v.CFrame
                break
            end
        end
    end
end

