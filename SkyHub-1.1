local function createDropdown(p,label,y,items,def,cb)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,-5,0,32)
    row.Position=UDim2.new(0,2,0,y)
    row.BackgroundTransparency=1
    row.Parent=p
    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(0.4,0,1,0)
    lbl.BackgroundTransparency=1
    lbl.Text=label
    lbl.TextColor3=Color3.new(0.9,0.9,1)
    lbl.Font=Enum.Font.Gotham
    lbl.TextSize=13
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.Parent=row
    local dd=Instance.new("TextButton")
    dd.Size=UDim2.new(0.35,0,0.7,0)
    dd.Position=UDim2.new(0.5,0,0.15,0)
    dd.Text=def or"Выберите"
    dd.TextColor3=Color3.new(1,1,1)
    dd.BackgroundColor3=Color3.fromRGB(60,60,80)
    dd.Font=Enum.Font.Gotham
    dd.TextSize=12
    dd.Parent=row
    Instance.new("UICorner").Parent=dd
    local menu=Instance.new("Frame")
    menu.Size=UDim2.new(0.35,0,0,0)
    menu.Position=UDim2.new(0.5,0,1,2)
    menu.BackgroundColor3=Color3.fromRGB(40,40,60)
    menu.Visible=false
    menu.Parent=row
    Instance.new("UICorner").Parent=menu
    local function upd()
        for _,v in ipairs(menu:GetChildren()) do v:Destroy() end
        for _,it in ipairs(items) do
            local b=Instance.new("TextButton")
            b.Size=UDim2.new(1,0,0,26)
            b.Text=(type(it)=="string")and it or it.Name
            b.TextColor3=Color3.new(1,1,1)
            b.BackgroundColor3=Color3.fromRGB(50,50,70)
            b.Font=Enum.Font.Gotham
            b.TextSize=12
            b.Parent=menu
            b.MouseButton1Click:Connect(function()
                dd.Text=b.Text
                menu.Visible=false
                menu.Size=UDim2.new(0.35,0,0,0)
                cb(it)
            end)
        end
        local count=#items
        menu.Size=UDim2.new(0.35,0,0,count*26+5)
    end
    dd.MouseButton1Click:Connect(function()
        menu.Visible=not menu.Visible
        if menu.Visible then upd() end
    end)
    return dd
end

