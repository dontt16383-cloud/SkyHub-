local function tpPlayer(p)
    local ch=p.Character
    if not ch then return end
    local root=ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
    if not root then return end
    local my=LP.Character
    if not my then return end
    local myRoot=my:FindFirstChild("HumanoidRootPart") or my:FindFirstChild("Torso")
    if myRoot then
        myRoot.CFrame=root.CFrame+Vector3.new(0,3,0)
    end
end

