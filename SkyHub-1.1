local function getHum()
    local c=LP.Character
    return c and c:FindFirstChild("Humanoid")
end

local function getRoot()
    local c=LP.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
end

local function applyInvis(p)
    if p:IsA("BasePart") then
        p.Transparency = cInvis and 1 or 0
    end
end

local function applySettings()
    local hum=getHum()
    if not hum then return end
    hum.WalkSpeed=cWalk
    hum.JumpPower=infJump and 9999 or cJump
    hum.Scale=cScale
    if iGodMode then
        hum.MaxHealth=9e9
        hum.Health=9e9
        hum.BreakJointsOnDeath=false
    else
        hum.MaxHealth=100
        hum.BreakJointsOnDeath=true
    end
    local char=LP.Character
    if not char then return end
    for _,v in ipairs(char:GetDescendants()) do applyInvis(v) end
    for _,v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide=not noclip
        end
    end
end

local function trackInvis(char)
    char.DescendantAdded:Connect(function(p)
        if cInvis then applyInvis(p) end
        if noclip and p:IsA("BasePart") then
            p.CanCollide=false
        end
    end)
end

local function startFly()
    local root=getRoot()
    local hum=getHum()
    if not root or not hum then return end
    if flyBV then flyBV:Destroy() end
    if flyGyro then flyGyro:Destroy() end
    if flyConn then flyConn:Disconnect() end
    flyBV=Instance.new("BodyVelocity")
    flyBV.MaxForce=Vector3.new(1,1,1)*1e6
    flyBV.Velocity=Vector3.new(0,0,0)
    flyBV.Parent=root
    flyGyro=Instance.new("BodyGyro")
    flyGyro.MaxTorque=Vector3.new(1,1,1)*1e6
    flyGyro.CFrame=root.CFrame
    flyGyro.Parent=root
    hum.PlatformStand=true
    hum.AutoRotate=false
    flyConn=RunService.Heartbeat:Connect(function(dt)
        if not fly or not root or not root.Parent then return end
        local cam=workspace.CurrentCamera
        if not cam then return end
        local cf=cam.CFrame
        local fwd=cf.LookVector*Vector3.new(1,0,1)
        if fwd.Magnitude<0.01 then fwd=Vector3.new(1,0,0) end
        fwd=fwd.Unit
        local right=cf.RightVector*Vector3.new(1,0,1)
        if right.Magnitude<0.01 then right=Vector3.new(1,0,0) end
        right=right.Unit
        local up=Vector3.new(0,1,0)
        local move=Vector3.new(0,0,0)
        if UIS:IsKeyDown(Enum.KeyCode.W) then move=move+fwd end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move=move-fwd end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move=move-right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move=move+right end
        local vert=0
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vert=1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vert=-1 end
        if move.Magnitude>0 then move=move.Unit*flySpd end
        local vel=move+up*vert*flySpd*0.8
        flyBV.Velocity=vel
        if flyAnim then
            flyPulse=(flyPulse or 0)+dt*2
            flyBV.Velocity=flyBV.Velocity+Vector3.new(0,math.sin(flyPulse)*0.6,0)
        end
    end)
end

local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV=nil end
    if flyGyro then flyGyro:Destroy(); flyGyro=nil end
    if flyConn then flyConn:Disconnect(); flyConn=nil end
    local hum=getHum()
    if hum then
        hum.PlatformStand=false
        hum.AutoRotate=true
    end
end

