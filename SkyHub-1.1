local combatLoop=RunService.Heartbeat:Connect(function()
    if sAimbot then
        local t=findClosest("Murder")
        if t then aimbot(t) end
    end
    if sTrigger then
        local t=findClosest("Murder")
        if t then
            local cam=workspace.CurrentCamera
            if cam then
                local ch=t.Character
                if ch then
                    local head=ch:FindFirstChild("Head")or ch:FindFirstChild("HumanoidRootPart")
                    if head then
                        local pos,onScreen=cam:WorldToScreenPoint(head.Position)
                        if onScreen then
                            local size=cam.ViewportSize
                            local center=Vector2.new(size.X/2,size.Y/2)
                            if(Vector2.new(pos.X,pos.Y)-center).Magnitude<50 then
                                triggerBot()
                            end
                        end
                    end
                end
            end
        end
    end
    if sAutoKill then
        local t=findClosest("Murder")
        if t then kill(t) end
    end
    if sAutoShoot then
        local t=findClosest("Murder")
        if t then
            local mouse=game:GetService("Players").LocalPlayer:GetMouse()
            if mouse then mouse:Button1Down();task.wait(0.05);mouse:Button1Up()end
        end
    end
    if mAutoKillSheriff then
        local t=findRole("Sheriff")
        if t then kill(t) end
    end
    if mAutoKillAll then
        for _,p in ipairs(getOther())do kill(p)end
    end
end)

