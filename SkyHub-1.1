local function applySky(preset)
    skyPreset=preset
    local sky=Lighting:FindFirstChild("Sky") or Instance.new("Sky")
    sky.Parent=Lighting
    local ids={Default="rbxasset://textures/sky/skybox/",Sunset="rbxassetid://189338394",Night="rbxassetid://189338466",Space="rbxassetid://189338532"}
    local id=ids[preset] or ids.Default
    if preset=="Default" then
        for _,d in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do
            sky["Skybox"..d]=id.."sky"..d..".tex"
        end
    else
        for _,d in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do
            sky["Skybox"..d]=id
        end
    end
end

local function applyWeather(preset)
    weatherPreset=preset
    local fogEnd={Clear=1000,Rain=300,Foggy=150}
    local fogStart={Clear=0,Rain=50,Foggy=10}
    local bright={Clear=1,Rain=0.6,Foggy=0.8}
    local ambient={Clear=Color3.new(0.5,0.5,0.5),Rain=Color3.new(0.3,0.3,0.4),Foggy=Color3.new(0.6,0.6,0.7)}
    local climate={Clear=Enum.Climate.Default,Rain=Enum.Climate.Rainy,Foggy=Enum.Climate.Foggy}
    Lighting.FogEnd=fogEnd[preset] or 1000
    Lighting.FogStart=fogStart[preset] or 0
    Lighting.Brightness=bright[preset] or 1
    Lighting.Ambient=ambient[preset] or Color3.new(0.5,0.5,0.5)
    Lighting.Climate=climate[preset] or Enum.Climate.Default
end

local function applyTime(v)
