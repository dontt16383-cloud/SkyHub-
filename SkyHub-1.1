local function updateGun(obj)
    if not espG then
        if gh[obj] then gh[obj]:Destroy(); gh[obj]=nil end
        return
    end
    if obj:IsA("Tool") or obj:IsA("Model") then
        local n=obj.Name:lower()
        if n:find("gun") or n:find("pistol") or n:find("weapon") then
            local par=obj.Parent
            if par and par:FindFirstChild("Humanoid") then return end
            if obj:IsDescendantOf(workspace) and not obj:IsDescendantOf(LP.Character) then
                if gh[obj] then gh[obj]:Destroy(); gh[obj]=nil end
                local hl=Instance.new("Highlight")
                hl.Parent=obj
                hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillColor=Color3.new(1,1,0)
                hl.OutlineColor=Color3.new(1,1,0)
                hl.FillTransparency=0.3
                gh[obj]=hl
            end
        end
    end
end

local function scanGuns()
