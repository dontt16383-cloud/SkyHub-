local function updateGlow()
    if glowObj then glowObj:Destroy(); glowObj=nil end
    if not glow then return end
    local char=LP.Character
    if not char then return end
    local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end
    glowObj=Instance.new("PointLight")
    glowObj.Parent=torso
    glowObj.Color=Color3.new(0,1,1)
    glowObj.Brightness=2
    glowObj.Range=10
    glowObj.Enabled=true
end

local function getRole(p)
    if p==LP then return nil end
    if p.Team then
        local n=p.Team.Name
        if n=="Murderer" or n=="Murder" then return "Murder"
        elseif n=="Sheriff" or n=="Sheriffs" then return "Sheriff"
        else return "Innocent" end
    end
    if p.TeamColor then
        local c=p.TeamColor.Color
        if c==Color3.new(1,0,0) then return "Murder"
        elseif c==Color3.new(0,0,1) then return "Sheriff" end
    end
    return "Innocent"
end

local function updateHighlight(p)
    if p==LP then return end
    if not espP then
        if ph[p] then ph[p]:Destroy(); ph[p]=nil end
        return
    end
    local ch=p.Character
    if not ch then return end
    if ph[p] then ph[p]:Destroy(); ph[p]=nil end
    local role=getRole(p)
    local colors={Murder=Color3.new(1,0,0),Sheriff=Color3.new(0,0,1),Innocent=Color3.new(0,1,0)}
    local hl=Instance.new("Highlight")
    hl.Parent=ch
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor=colors[role] or Color3.new(0,1,0)
    hl.OutlineColor=Color3.new(1,1,1)
    hl.FillTransparency=0.4
    ph[p]=hl
end

local function refreshAll()
