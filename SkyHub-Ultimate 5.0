local SONGS={"Макс Корж - Мотылёк","Okean Elzy - Обійми","Imagine Dragons - Believer","Моргенштерн - Малышка","Антитіла - TDME","Ed Sheeran - Shape of You","Sia - Unstoppable","Eminem - Lose Yourself","The Weeknd - Blinding Lights","Dua Lipa - Levitating"}
local function playEmote(name)local id=EMOTE_IDS[name];if not id then return end;local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid");if h then local a=Instance.new("Animation");a.AnimationId=id;local t=h:LoadAnimation(a);t:Play();C.CurEmote=t end end
local function playAnimation(name)if not name or name==""then return end;local pack=ANIM_PACKS[name];if not pack then return end;local c=LP.Character;if not c then return end;local an=c:FindFirstChild("Animate");if not an then return end;local function set(o,id)if o and id then o.AnimationId="rbxassetid://"..tostring(id)end end;local function ensure(f,nam)if not f then return nil end;local a=f:FindFirstChild(nam);if not a then a=Instance.new("Animation");a.Name=nam;a.Parent=f end;return a end;local run=ensure(an:FindFirstChild("run"),"RunAnim");local walk=ensure(an:FindFirstChild("walk"),"WalkAnim");local jump=ensure(an:FindFirstChild("jump"),"JumpAnim");local fall=ensure(an:FindFirstChild("fall"),"FallAnim");local climb=ensure(an:FindFirstChild("climb"),"ClimbAnim");local swim=ensure(an:FindFirstChild("swim"),"Swim");local swimIdle=ensure(an:FindFirstChild("swimidle"),"SwimIdle");local idle=an:FindFirstChild("idle");set(walk,pack.WalkAnim or pack.Walk);set(run,pack.RunAnim or pack.Run);set(jump,pack.JumpAnim or pack.Jump);set(fall,pack.FallAnim or pack.Fall);set(climb,pack.ClimbAnim or pack.Climb);set(swim,pack.Swim);set(swimIdle,pack.SwimIdle or pack.Swim);if idle then local a1=idle:FindFirstChild("Animation1");local a2=idle:FindFirstChild("Animation2");if pack.Animation1 then set(a1,pack.Animation1)end;if pack.Animation2 then set(a2,pack.Animation2)end;if pack.Idle then if a1 and pack.Idle[1]then set(a1,pack.Idle[1])end;if a2 and pack.Idle[2]then set(a2,pack.Idle[2]or pack.Idle[1])end end end;an.Disabled=true;task.wait(0.06);an.Disabled=false;local h=c:FindFirstChildOfClass("Humanoid");if h then pcall(function()h:ChangeState(Enum.HumanoidStateType.Landed);task.wait(0.03);h:ChangeState(Enum.HumanoidStateType.Running)end)end;S.AnimPackName=name end
local function toggleHeadless(v)S.Headless=v;local c=LP.Character;if not c then return end;local head=c:FindFirstChild("Head");if head then head.LocalTransparencyModifier=v and 1 or 0 end end
local function toggleKorblox(v)S.Korblox=v;local c=LP.Character;if not c then return end;local leg=c:FindFirstChild("LeftLowerLeg")or c:FindFirstChild("LeftLeg");if leg and leg:IsA("BasePart")then leg.LocalTransparencyModifier=v and 1 or 0 end end
local function toggleJerk(v)S.Jerk=v;if v then if C.JerkConn then C.JerkConn:Disconnect()end;C.JerkConn=RS.Heartbeat:Connect(function()if not LP.Character then return end;local hp=LP.Character:FindFirstChild("HumanoidRootPart");if hp then hp.AssemblyLinearVelocity=Vector3.new(math.random(-50,50),math.random(-30,30),math.random(-50,50))end end);nt("Jerk","Включен",2)else if C.JerkConn then C.JerkConn:Disconnect();C.JerkConn=nil end;nt("Jerk","Выключен",2)end end
local function playSong(name)if C.SoundObj then pcall(function()C.SoundObj:Destroy()end);C.SoundObj=nil end;local ids={["Макс Корж - Мотылёк"]="rbxassetid://1839116943",["Okean Elzy - Обійми"]="rbxassetid://1839116944",["Imagine Dragons - Believer"]="rbxassetid://1839116945",["Моргенштерн - Малышка"]="rbxassetid://1839116946",["Антитіла - TDME"]="rbxassetid://1839116947",["Ed Sheeran - Shape of You"]="rbxassetid://1839116948",["Sia - Unstoppable"]="rbxassetid://1839116949",["Eminem - Lose Yourself"]="rbxassetid://1839116950",["The Weeknd - Blinding Lights"]="rbxassetid://1839116951",["Dua Lipa - Levitating"]="rbxassetid://1839116952"};local id=ids[name];if not id then return end;local s=Instance.new("Sound");s.SoundId=id;s.Parent=game:GetService("CoreGui");s:Play();C.SoundObj=s end
local function getValidCoins()local coins={};local hp=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart");if not hp then return coins end;for _,m in pairs(WS:GetChildren())do local cont=m:FindFirstChild("CoinContainer");if cont then for _,c in pairs(cont:GetChildren())do if c.Name=="Coin_Server"and c:IsA("BasePart")and c:FindFirstChild("TouchInterest")then table.insert(coins,{part=c,dist=(hp.Position-c.Position).Magnitude})end end end end;table.sort(coins,function(a,b)return a.dist<b.dist end);return coins end
local function tweenToCoin(coin)if not coin or not coin.Parent or not coin:FindFirstChild("TouchInterest")then return false end;local c=LP.Character;if not c then return false end;local hp=c:FindFirstChild("HumanoidRootPart");local h=c:FindFirstChildOfClass("Humanoid");if not hp or not h then return false end;local targ=coin.Position+Vector3.new(0,2,0);if(hp.Position-targ).Magnitude<5 then return true end;if C.CurTween then pcall(function()C.CurTween:Cancel()end)end;C.CurTween=TS:Create(hp,TweenInfo.new((hp.Position-targ).Magnitude/S.AutoFarmSpd,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=CFrame.new(targ)});h.Sit=true;C.CurTween:Play();local done=false;local co=C.CurTween.Completed:Connect(function()done=true end);local t0=tick();while not done and S.AutoFarm do task.wait(0.1);if not coin or not coin.Parent or not coin:FindFirstChild("TouchInterest")then if C.CurTween then pcall(function()C.CurTween:Cancel()end)end;h.Sit=false;return false end;if tick()-t0>30 then if C.CurTween then pcall(function()C.CurTween:Cancel()end)end;h.Sit=false;return false end end;h.Sit=false;return done end
local function collectCoin(coin)if not coin or not coin.Parent then return end;local hp=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart");if not hp then return end;pcall(function()firetouchinterest(hp,coin,0);task.wait(0.05);firetouchinterest(hp,coin,1)end)end
local function farmLoop()while S.AutoFarm do if not LP.Character then task.wait(1)continue end;local coins=getValidCoins();if #coins==0 then task.wait(2)continue end;local ok=tweenToCoin(coins[1].part);if ok and S.AutoFarm then collectCoin(coins[1].part);task.wait(S.AutoFarmDelay)end;task.wait(0.1)end;C.AutoFarmConn=nil end
local function setupAutoFarm()if S.AutoFarm then if not LP.Character then return end;C.AutoFarmConn=task.spawn(farmLoop);nt("Авто фарм","Запущен",3)else if LP.Character then local h=LP.Character:FindFirstChildOfClass("Humanoid");if h then h.Sit=false end end;if C.CurTween then pcall(function()C.CurTween:Cancel()end);C.CurTween=nil end end end
local function updateVisuals()for _,p in ipairs(P:GetPlayers())do if p==LP then if S.Chams then applyChams(p)elseif C.ChamsParts[p.UserId]then remChams(p)end;continue end;if not p.Character then continue end;local r=getRole(p);if S.MurderESP and r=="Murder"then createHL(p,S.MurderCol)elseif S.SheriffESP and r=="Sheriff"then createHL(p,S.SheriffCol)elseif S.InnocentESP and r=="Innocent"then createHL(p,S.InnocentCol)else remHL(p)end;if S.Chams then applyChams(p)elseif C.ChamsParts[p.UserId]then remChams(p)end end end
local function startMainUpdate()sd(C.MainConn);C.MainConn=nil;C.MainConn=RS.Heartbeat:Connect(function()if S.MurderESP or S.SheriffESP or S.InnocentESP or S.Chams or S.Trails or S.Tracers then updateVisuals()end;if S.Tracers then updateTracers()end;if S.JumpCircles then updateJumpCircles()end end)end
