task.spawn(function()
    while ScreenGui.Parent do
        local fps = math.floor(1 / math.max(RunService.RenderStepped:Wait(), 0.001))
        FPS.Text = "SKYHUB | FPS: " .. fps .. " | Free"
        task.wait(1)
    end
end)

