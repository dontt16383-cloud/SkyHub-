local oh=Instance.new("Frame");oh.Name="Header";oh.Size=UDim2.new(0,150,0,30);oh.Position=UDim2.new(1,-160,0,10);oh.BackgroundColor3=Color3.fromRGB(15,15,20);oh.BackgroundTransparency=0.05;oh.BorderSizePixel=0;oh.ClipsDescendants=true;oh.Parent=ov;local oc=Instance.new("UICorner");oc.CornerRadius=UDim.new(1,0);oc.Parent=oh;local os=Instance.new("UIStroke");os.Color=Color3.fromRGB(40,40,50);os.Thickness=1;os.Transparency=0.5;os.Parent=oh;local ot=Instance.new("TextLabel");ot.Size=UDim2.new(0,48,1,0);ot.Position=UDim2.new(0,4,0,0);ot.BackgroundTransparency=1;ot.Text="SKYHUB";ot.TextColor3=Color3.fromRGB(255,255,255);ot.TextSize=12;ot.Font=FB;ot.TextXAlignment=Enum.TextXAlignment.Center;ot.Parent=oh;local os1=Instance.new("Frame");os1.Size=UDim2.new(0,1,0,16);os1.Position=UDim2.new(0,56,0.5,-8);os1.BackgroundColor3=Color3.fromRGB(60,60,70);os1.BorderSizePixel=0;os1.Parent=oh;local fps=Instance.new("TextLabel");fps.Size=UDim2.new(0,38,1,0);fps.Position=UDim2.new(0,61,0,0);fps.BackgroundTransparency=1;fps.Text="60";fps.TextColor3=Color3.fromRGB(180,255,180);fps.TextSize=12;fps.Font=F;fps.TextXAlignment=Enum.TextXAlignment.Center;fps.Parent=oh;local os2=Instance.new("Frame");os2.Size=UDim2.new(0,1,0,16);os2.Position=UDim2.new(0,103,0.5,-8);os2.BackgroundColor3=Color3.fromRGB(60,60,70);os2.BorderSizePixel=0;os2.Parent=oh;local flb=Instance.new("TextLabel");flb.Size=UDim2.new(0,40,1,0);flb.Position=UDim2.new(0,108,0,0);flb.BackgroundTransparency=1;flb.Text="Free";flb.TextColor3=Color3.fromRGB(150,255,150);flb.TextSize=11;flb.Font=F;flb.TextXAlignment=Enum.TextXAlignment.Center;flb.Parent=oh
oh.MouseButton1Click:Connect(function()container.Visible=not container.Visible;if container.Visible then switchTab("Player")end end)
local fc=0;local lt=tick()
RS.RenderStepped:Connect(function()fc=fc+1;local ct=tick();if ct-lt>=1 then local f=math.floor(fc/(ct-lt));fps.Text=f;if f>=60 then fps.TextColor3=Color3.fromRGB(180,255,180)elseif f>=30 then fps.TextColor3=Color3.fromRGB(255,255,150)else fps.TextColor3=Color3.fromRGB(255,150,150)end;fc=0;lt=ct end end)
local od=false;local ods,osp
oh.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then od=true;ods=i.Position;osp=oh.Position end end)
oh.InputChanged:Connect(function(i)if od and(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch)then local d=i.Position-ods;oh.Position=UDim2.new(osp.X.Scale,osp.X.Offset+d.X,osp.Y.Scale,osp.Y.Offset+d.Y)end end)
oh.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then od=false end end)
Mini.MouseButton1Click:Connect(function()main.Visible=true;Mini.Visible=false;switchTab("Player")end)
