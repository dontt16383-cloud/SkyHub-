local function applyTheme(name)local themes={Dark={Main=Color3.fromRGB(18,18,22),Card=Color3.fromRGB(25,25,31),Accent=Color3.fromRGB(90,90,100)},Blue={Main=Color3.fromRGB(14,20,30),Card=Color3.fromRGB(20,30,45),Accent=Color3.fromRGB(40,130,255)},Purple={Main=Color3.fromRGB(18,14,27),Card=Color3.fromRGB(28,20,42),Accent=Color3.fromRGB(145,70,255)},Green={Main=Color3.fromRGB(14,25,18),Card=Color3.fromRGB(20,38,26),Accent=Color3.fromRGB(60,210,110)},Red={Main=Color3.fromRGB(27,15,17),Card=Color3.fromRGB(40,20,23),Accent=Color3.fromRGB(230,65,75)},Gray={Main=Color3.fromRGB(28,28,28),Card=Color3.fromRGB(38,38,38),Accent=Color3.fromRGB(160,160,160)}};local t=themes[name]or themes.Purple;main.BackgroundColor3=t.Main;header.BackgroundColor3=t.Card;tabBar.BackgroundColor3=t.Card;contentArea.BackgroundColor3=t.Card;Theme.Accent=t.Accent;Theme.Main=t.Main;Theme.Card=t.Card end
local header=Instance.new("Frame");header.Name="Header";header.Size=UDim2.new(1,0,0,52);header.BackgroundColor3=Theme.Card;header.BorderSizePixel=0;header.Parent=main
local title=Instance.new("TextLabel");title.Size=UDim2.new(0,300,1,0);title.Position=UDim2.new(0,20,0,0);title.BackgroundTransparency=1;title.Text="SKYHUB";title.TextColor3=Theme.Text;title.TextSize=18;title.Font=FB;title.TextXAlignment=Enum.TextXAlignment.Left;title.Parent=header
local closeBtn=Instance.new("TextButton");closeBtn.Size=UDim2.new(0,36,0,36);closeBtn.Position=UDim2.new(1,-46,0.5,-18);closeBtn.BackgroundColor3=Theme.Element;closeBtn.Text="х";closeBtn.TextColor3=Theme.SubText;closeBtn.TextSize=16;closeBtn.Font=FB;closeBtn.AutoButtonColor=false;closeBtn.BorderSizePixel=0;closeBtn.Parent=header;closeBtn.MouseButton1Click:Connect(function()container.Visible=false end)
local Mini=Instance.new("TextButton");Mini.Size=UDim2.new(0,55,0,55);Mini.Position=UDim2.fromScale(0.05,0.5);Mini.AnchorPoint=Vector2.new(0,0.5);Mini.BackgroundColor3=Theme.Accent;Mini.Text="S";Mini.TextColor3=Color3.new(1,1,1);Mini.Font=Enum.Font.GothamBlack;Mini.TextSize=28;Mini.Visible=false;Mini.Parent=sg;Instance.new("UICorner",Mini).CornerRadius=UDim.new(0,15)
