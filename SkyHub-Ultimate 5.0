local content=Instance.new("ScrollingFrame");content.Name="Content";content.Size=UDim2.new(1,0,1,0);content.BackgroundTransparency=1;content.BorderSizePixel=0;content.ScrollBarThickness=6;content.ScrollBarImageColor3=Theme.Accent;content.CanvasSize=UDim2.new(0,0,0,0);content.Parent=contentArea
local contentP=Instance.new("UIPadding");contentP.PaddingTop=UDim.new(0,12);contentP.PaddingBottom=UDim.new(0,12);contentP.PaddingLeft=UDim.new(0,12);contentP.PaddingRight=UDim.new(0,12);contentP.Parent=content
local tNames={"Player","ESP","Visual","Teleport","Fling","AutoFarm","Troll","Combat","Settings","Bio"}
local tButtons={};local tPages={}
local function updateCanvas()task.wait(0.05);local h=24;for _,page in pairs(tPages)do if page.Visible then for _,ch in ipairs(page:GetChildren())do if ch:IsA("Frame")and ch.Name~="UIListLayout"and ch.Name~="UIPadding"then h=h+ch.AbsoluteSize.Y+12 end end end end;content.CanvasSize=UDim2.new(0,0,0,h+20)end
local function switchTab(name)for n,btn in pairs(tButtons)do if btn then TS:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Theme.Card}):Play();local lbl=btn:FindFirstChild("Label");if lbl then TS:Create(lbl,TweenInfo.new(0.2),{TextColor3=Theme.SubText}):Play()end end end;for n,page in pairs(tPages)do if page then page.Visible=false end end;local btn=tButtons[name];if btn then TS:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Theme.Element}):Play();local lbl=btn:FindFirstChild("Label");if lbl then TS:Create(lbl,TweenInfo.new(0.2),{TextColor3=Theme.Text}):Play()end end;if tPages[name]then tPages[name].Visible=true end;updateCanvas()end
for i,name in ipairs(tNames)do local btn=Instance.new("TextButton");btn.Name=name.."Btn";btn.Size=UDim2.new(1,0,0,42);btn.BackgroundColor3=Theme.Card;btn.Text=name;btn.TextColor3=Theme.SubText;btn.TextSize=13;btn.Font=F;btn.TextXAlignment=Enum.TextXAlignment.Left;btn.AutoButtonColor=false;btn.BorderSizePixel=0;btn.Parent=tabBar;local pad=Instance.new("UIPadding");pad.PaddingLeft=UDim.new(0,12);pad.Parent=btn;tButtons[name]=btn;local page=Instance.new("Frame");page.Name=name.."Page";page.Size=UDim2.new(1,0,1,0);page.BackgroundTransparency=1;page.Visible=false;page.Parent=content;local pl=Instance.new("UIListLayout");pl.Padding=UDim.new(0,12);pl.SortOrder=Enum.SortOrder.LayoutOrder;pl.FillDirection=Enum.FillDirection.Vertical;pl.Parent=page;pl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas);tPages[name]=page;btn.MouseButton1Click:Connect(function()switchTab(name)end)end
local function createCard(page,title,order)local card=Instance.new("Frame");card.Name=title.."Card";card.BackgroundColor3=Theme.Element;card.BorderSizePixel=0;card.LayoutOrder=order;card.Size=UDim2.new(1,0,0,0);card.AutomaticSize=Enum.AutomaticSize.Y;card.Parent=page;local pad=Instance.new("UIPadding");pad.PaddingTop=UDim.new(0,10);pad.PaddingBottom=UDim.new(0,10);pad.PaddingLeft=UDim.new(0,10);pad.PaddingRight=UDim.new(0,10);pad.Parent=card;local list=Instance.new("UIListLayout");list.Padding=UDim.new(0,8);list.SortOrder=Enum.SortOrder.LayoutOrder;list.Parent=card;local head=Instance.new("TextLabel");head.Name="CardTitle";head.Size=UDim2.new(1,0,0,20);head.BackgroundTransparency=1;head.Text=title;head.TextColor3=Theme.Text;head.TextSize=15;head.Font=FB;head.TextXAlignment=Enum.TextXAlignment.Left;head.LayoutOrder=0;head.Parent=card;local sep=Instance.new("Frame");sep.Name="Separator";sep.Size=UDim2.new(1,0,0,1);sep.BackgroundColor3=Theme.Stroke;sep.BorderSizePixel=0;sep.LayoutOrder=1;sep.Parent=card;return card end
local function createToggle(card,name,def,cb)local f=Instance.new("Frame");f.Name=name.."Toggle";f.Size=UDim2.new(1,0,0,32);f.BackgroundTransparency=1;f.LayoutOrder=10;f.Parent=card;local lb=Instance.new("TextLabel");lb.Size=UDim2.new(0.6,0,1,0);lb.BackgroundTransparency=1;lb.Text=name;lb.TextColor3=Theme.SubText;lb.TextSize=14;lb.Font=F;lb.TextXAlignment=Enum.TextXAlignment.Left;lb.Parent=f;local btn=Instance.new("TextButton");btn.Size=UDim2.new(0,44,0,24);btn.Position=UDim2.new(0.6,0,0.5,-12);btn.BackgroundColor3=Theme.Card;btn.Text="";btn.AutoButtonColor=false;btn.BorderSizePixel=0;btn.Parent=f;local knob=Instance.new("Frame");knob.Size=UDim2.new(0,18,0,18);knob.Position=UDim2.new(0,3,0.5,-9);knob.BackgroundColor3=Theme.SubText;knob.BorderSizePixel=0;knob.Parent=btn;local on=def or false;local function upd()if on then TS:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Theme.Accent}):Play();TS:Create(knob,TweenInfo.new(0.2),{Position=UDim2.new(1,-21,0.5,-9),BackgroundColor3=Theme.Text}):Play()else TS:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Theme.Card}):Play();TS:Create(knob,TweenInfo.new(0.2),{Position=UDim2.new(0,3,0.5,-9),BackgroundColor3=Theme.SubText}):Play()end;if cb then cb(on)end end;btn.MouseButton1Click:Connect(function()on=not on;upd()end);upd()end
local function createSlider(card,name,min,max,def,cb)local f=Instance.new("Frame");f.Name=name.."Slider";f.Size=UDim2.new(1,0,0,50);f.BackgroundTransparency=1;f.LayoutOrder=10;f.Parent=card;local lb=Instance.new("TextLabel");lb.Size=UDim2.new(0.7,0,0,20);lb.BackgroundTransparency=1;lb.Text=name;lb.TextColor3=Theme.SubText;lb.TextSize=13;lb.Font=F;lb.TextXAlignment=Enum.TextXAlignment.Left;lb.Parent=f;local val=Instance.new("TextLabel");val.Size=UDim2.new(0.3,0,0,20);val.Position=UDim2.new(0.7,0,0,0);val.BackgroundTransparency=1;val.Text=tostring(def or min);val.TextColor3=Theme.Accent;val.TextSize=13;val.Font=FB;val.TextXAlignment=Enum.TextXAlignment.Right;val.Parent=f;local back=Instance.new("Frame");back.Size=UDim2.new(1,0,0,6);back.Position=UDim2.new(0,0,0,32);back.BackgroundColor3=Theme.Card;back.BorderSizePixel=0;back.Parent=f;local fill=Instance.new("Frame");fill.Size=UDim2.new((def-min)/(max-min),0,1,0);fill.BackgroundColor3=Theme.Accent;fill.BorderSizePixel=0;fill.Parent=back;local drag=false;local cur=def or min;local function upd(i)local pos=math.clamp((i.Position.X-back.AbsolutePosition.X)/back.AbsoluteSize.X,0,1);cur=math.floor(min+(max-min)*pos);val.Text=tostring(cur);TS:Create(fill,TweenInfo.new(0.1),{Size=UDim2.new(pos,0,1,0)}):Play();if cb then cb(cur)end end;back.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true;upd(i)end end);back.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end);UIS.InputChanged:Connect(function(i)if drag and(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch)then upd(i)end end)end
local function createButton(card,name,cb)local btn=Instance.new("TextButton");btn.Name=name.."Btn";btn.Size=UDim2.new(1,0,0,34);btn.BackgroundColor3=Theme.Card;btn.Text=name;btn.TextColor3=Theme.Text;btn.TextSize=13;btn.Font=F;btn.AutoButtonColor=false;btn.LayoutOrder=10;btn.BorderSizePixel=0;btn.Parent=card;btn.MouseButton1Click:Connect(function()if cb then cb()end end)end
local function createColorInput(card,name,def,cb)local f=Instance.new("Frame");f.Name=name.."Color";f.Size=UDim2.new(1,0,0,32);f.BackgroundTransparency=1;f.LayoutOrder=11;f.Parent=card;local lb=Instance.new("TextLabel");lb.Size=UDim2.new(0.5,0,1,0);lb.BackgroundTransparency=1;lb.Text=name.." Цвет";lb.TextColor3=Theme.SubText;lb.TextSize=13;lb.Font=F;lb.TextXAlignment=Enum.TextXAlignment.Left;lb.Parent=f;local box=Instance.new("TextBox");box.Size=UDim2.new(0.4,0,0,26);box.Position=UDim2.new(0.5,0,0.5,-13);box.BackgroundColor3=Theme.Card;box.TextColor3=Theme.Text;local r=math.floor(def.R*255);local g=math.floor(def.G*255);local b=math.floor(def.B*255);box.Text=r..","..g..","..b;box.PlaceholderText="R,G,B или #HEX";box.PlaceholderColor3=Theme.SubText;box.TextSize=12;box.Font=F;box.ClearTextOnFocus=false;box.BorderSizePixel=0;box.Parent=f;local prev=Instance.new("Frame");prev.Size=UDim2.new(0,20,0,20);prev.Position=UDim2.new(0.92,0,0.5,-10);prev.BackgroundColor3=def;prev.BorderSizePixel=1;prev.BorderColor3=Theme.Stroke;prev.Parent=f;local pc=Instance.new("UICorner");pc.CornerRadius=UDim.new(0,4);pc.Parent=prev;box.FocusLost:Connect(function(e)if e then local col=ci2c(box.Text);if col then prev.BackgroundColor3=col;if cb then cb(col)end else nt("Цвет","Неверный формат!",2)end end end)end
local pp=tPages["Player"];local pCard=createCard(pp,"Player",1)
createSlider(pCard,"Скорость",0,100,S.Speed,function(v)S.Speed=v;if LP.Character and LP.Character:FindFirstChild("Humanoid")then LP.Character.Humanoid.WalkSpeed=v end end)
createSlider(pCard,"Прыжок",0,200,S.JumpPower,function(v)S.JumpPower=v;if LP.Character and LP.Character:FindFirstChild("Humanoid")then LP.Character.Humanoid.JumpPower=v end end)
createSlider(pCard,"Размер",0.1,5,S.CharScale,function(v)S.CharScale=v;if LP.Character then for _,p in ipairs(LP.Character:GetDescendants())do if p:IsA("BasePart")and p.Name~="HumanoidRootPart"then p.Size=p.Size*(v/S.CharScale)end end end end)
createToggle(pCard,"Невидимость",S.Invis,function(v)S.Invis=v;if LP.Character then for _,o in ipairs(LP.Character:GetDescendants())do if o:IsA("BasePart")then o.LocalTransparencyModifier=v and 1 or 0 end end end end)
createToggle(pCard,"Полет",S.Fly,function(v)S.Fly=v;if v then startFly()else stopFly()end end)
createSlider(pCard,"Скорость полета",10,200,S.FlySpd,function(v)S.FlySpd=v end)
createToggle(pCard,"Анимация полета",S.FlyAnim,function(v)S.FlyAnim=v end)
createToggle(pCard,"Беск. прыжок",S.InfJump,function(v)S.InfJump=v end)
createToggle(pCard,"Noclip",S.Noclip,function(v)S.Noclip=v;setupNoclip(v)end)
createButton(pCard,"Сбросить Player",function()S.Speed=16;S.JumpPower=50;S.CharScale=1;S.Invis=false;S.Fly=false;S.FlySpd=50;S.FlyAnim=false;S.InfJump=false;S.Noclip=false;if LP.Character then local h=LP.Character:FindFirstChild("Humanoid");if h then h.WalkSpeed=16;h.JumpPower=50 end;for _,o in ipairs(LP.Character:GetDescendants())do if o:IsA("BasePart")then o.LocalTransparencyModifier=0 end end end;stopFly();setupNoclip(false);nt("Сброс","Player сброшен",2)end)
