--==================================================
-- VISUAL
--==================================================

local VisualPage = Pages.Visual

CreateToggle(VisualPage, "Glow", false, function(state)
    Settings.Glow = state

    local char = Player.Character
    if not char then return end

    local old = char:FindFirstChild("SkyHubGlow")

    if old then
        old:Destroy()
    end

    if state then
        local highlight = Instance.new("Highlight")
        highlight.Name = "SkyHubGlow"
        highlight.FillColor = Theme.Accent
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.FillTransparency = 0.5
        highlight.Parent = char
    end
end)

CreateToggle(VisualPage, "RGB Humanoid", false, function(state)
    Settings.RGB = state
end)

CreateToggle(VisualPage, "Bloom", false, function(state)
    Settings.Bloom = state

    local old = Lighting:FindFirstChild("SkyHubBloom")

    if old then
        old:Destroy()
    end

    if state then
        local bloom = Instance.new("BloomEffect")
        bloom.Name = "SkyHubBloom"
        bloom.Intensity = 1
        bloom.Size = 24
        bloom.Threshold = 0.8
        bloom.Parent = Lighting
    end
end)

CreateButton(VisualPage, "Clear Weather", function()
    Lighting.FogEnd = 100000
    Lighting.Brightness = 2
end)

CreateButton(VisualPage, "Fog", function()
    Lighting.FogEnd = 80
    Lighting.Brightness = 1
end)

CreateButton(VisualPage, "Night", function()
    Lighting.ClockTime = 0
end)

CreateButton(VisualPage, "Day", function()
    Lighting.ClockTime = 14
end)

