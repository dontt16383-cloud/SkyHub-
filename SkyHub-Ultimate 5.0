local C={FlyKeys={F=0,B=0,L=0,R=0},FlyRun=false,FlyGyro=nil,FlyVel=nil,FlyConn=nil,FlyKeyConn=nil,FlyKeyEnd=nil,Highlights={},ChamsParts={},Post={},JumpTrack={wasJump=false},RGBConn=nil,AutoFarmConn=nil,CurTween=nil,XRayParts={},Tracers={},TrailAttach={},FovCircle=nil,FovConn=nil,MainConn=nil,WallHopConn=nil,SheriffAutoShootConn=nil,ChinaHatParts={},ChinaHatConn=nil,ChinaHatDraw={},TexState={},TexBuilt=false,AuraParts={},AuraCache={},JerkConn=nil,SpinConn=nil,OrbizFolder=nil,OrbizParts={},OrbizConn=nil,KillAllConn=nil,KillAllRemote=nil,ShootBtn=nil,GrabGunRun=false,afkConn=nil,noclipConn=nil,BindConns={},BindPopup=nil,StretchConn=nil,BHopConn=nil,BHopBV=nil,BHopActive=false,AnimTrack=nil,SoundObj=nil,CurEmote=nil}
local function sd(c)if c and typeof(c)=="RBXScriptConnection"then pcall(function()c:Disconnect()end)end end
local function nt(t,c,d)pcall(function()game.StarterGui:SetCore("SendNotification",{Title=t,Text=c,Duration=d or 3})end)end
local function h2r(h)h=h:gsub("#","");if #h==6 then return Color3.fromRGB(tonumber("0x"..h:sub(1,2))or 255,tonumber("0x"..h:sub(3,4))or 255,tonumber("0x"..h:sub(5,6))or 255)end;return Color3.fromRGB(255,255,255)end
local function ci2c(v)if v:match("^#%x%x%x%x%x%x$")then return h2r(v)end;local p={};for q in v:gmatch("[^,]+")do table.insert(p,tonumber(q))end;if #p==3 then return Color3.fromRGB(p[1],p[2],p[3])end;return nil end
local function hasKnife(p)if not p or not p.Character then return false end;for _,i in ipairs(p.Character:GetDescendants())do if i:IsA("Tool")then local n=i.Name:lower();if n:find("knife")or n:find("blade")or n:find("dagger")then return true end end end;local bp=p:FindFirstChild("Backpack");if bp then for _,i in ipairs(bp:GetChildren())do if i:IsA("Tool")then local n=i.Name:lower();if n:find("knife")or n:find("blade")or n:find("dagger")then return true end end end end;return false end
local function hasGun(p)if not p or not p.Character then return false end;for _,i in ipairs(p.Character:GetDescendants())do if i:IsA("Tool")then local n=i.Name:lower();if n:find("gun")or n:find("pistol")or n:find("revolver")then return true end end end;local bp=p:FindFirstChild("Backpack");if bp then for _,i in ipairs(bp:GetChildren())do if i:IsA("Tool")then local n=i.Name:lower();if n:find("gun")or n:find("pistol")or n:find("revolver")then return true end end end end;return false end
local function getRole(p)if hasKnife(p)then return"Murder"end;if hasGun(p)then return"Sheriff"end;return"Innocent"end
local function getRoleCol(p)local r=getRole(p);if r=="Murder"then return S.MurderCol elseif r=="Sheriff"then return S.SheriffCol else return S.InnocentCol end end
local function stopFly()C.FlyRun=false;if C.FlyGyro then pcall(function()C.FlyGyro:Destroy()end);C.FlyGyro=nil end;if C.FlyVel then pcall(function()C.FlyVel:Destroy()end);C.FlyVel=nil end;if LP.Character and LP.Character:FindFirstChild("Humanoid")then LP.Character.Humanoid.PlatformStand=false end;C.FlyKeys={F=0,B=0,L=0,R=0};sd(C.FlyConn);C.FlyConn=nil end
local function startFly()if C.FlyRun then return end;local c=LP.Character;if not c then return end;local t=c:FindFirstChild("Torso")or c:FindFirstChild("UpperTorso");if not t then return end;C.FlyRun=true;C.FlyKeys={F=0,B=0,L=0,R=0};C.FlyGyro=Instance.new("BodyGyro",t);C.FlyGyro.P=9e4;C.FlyGyro.maxTorque=Vector3.new(9e9,9e9,9e9);C.FlyGyro.cframe=t.CFrame;C.FlyVel=Instance.new("BodyVelocity",t);C.FlyVel.velocity=Vector3.new(0,0.1,0);C.FlyVel.maxForce=Vector3.new(9e9,9e9,9e9);c.Humanoid.PlatformStand=true;sd(C.FlyConn);C.FlyConn=RS.RenderStepped:Connect(function()if not C.FlyRun or not LP.Character then stopFly();return end;local cam=workspace.CurrentCamera;local f=cam.CFrame.LookVector;local r=cam.CFrame.RightVector;local m=Vector3.new((C.FlyKeys.R-C.FlyKeys.L)*r.X+(C.FlyKeys.F-C.FlyKeys.B)*f.X,(C.FlyKeys.R-C.FlyKeys.L)*r.Y+(C.FlyKeys.F-C.FlyKeys.B)*f.Y,(C.FlyKeys.R-C.FlyKeys.L)*r.Z+(C.FlyKeys.F-C.FlyKeys.B)*f.Z)*S.FlySpd;if m.Magnitude>0 then C.FlyVel.velocity=m else C.FlyVel.velocity=Vector3.new(0,0.1,0)end;C.FlyGyro.cframe=cam.CFrame end);nt("Fly","Включен (WASD)",2)end
local function setupFlyKeys()sd(C.FlyKeyConn);sd(C.FlyKeyEnd);C.FlyKeyConn=UIS.InputBegan:Connect(function(i,g)if g or not C.FlyRun then return end;local k=i.KeyCode;if k==Enum.KeyCode.W then C.FlyKeys.F=1 elseif k==Enum.KeyCode.S then C.FlyKeys.B=1 elseif k==Enum.KeyCode.A then C.FlyKeys.L=1 elseif k==Enum.KeyCode.D then C.FlyKeys.R=1 end end);C.FlyKeyEnd=UIS.InputEnded:Connect(function(i,g)if g or not C.FlyRun then return end;local k=i.KeyCode;if k==Enum.KeyCode.W then C.FlyKeys.F=0 elseif k==Enum.KeyCode.S then C.FlyKeys.B=0 elseif k==Enum.KeyCode.A then C.FlyKeys.L=0 elseif k==Enum.KeyCode.D then C.FlyKeys.R=0 end end)end;setupFlyKeys()
local function stopBHop()C.BHopActive=false;sd(C.BHopConn);C.BHopConn=nil;if C.BHopBV then pcall(function()C.BHopBV:Destroy()end);C.BHopBV=nil end end
local function startBHop()if not LP.Character then return end;if C.BHopActive then stopBHop()end;local c=LP.Character;local h=c:FindFirstChildOfClass("Humanoid");local hp=c:FindFirstChild("HumanoidRootPart");if not h or not hp then return end;C.BHopActive=true;C.BHopBV=Instance.new("BodyVelocity");C.BHopBV.MaxForce=Vector3.new(1e5,0,1e5);C.BHopBV.Velocity=Vector3.new(0,0,0);C.BHopBV.Parent=hp;local lj=0;C.BHopConn=RS.Stepped:Connect(function()if not C.BHopActive then stopBHop();return end;local c=LP.Character;if not c then return end;local h=c:FindFirstChildOfClass("Humanoid");local hp=c:FindFirstChild("HumanoidRootPart");if not h or not hp then return end;if not C.BHopBV or not C.BHopBV.Parent then C.BHopBV=Instance.new("BodyVelocity");C.BHopBV.MaxForce=Vector3.new(1e5,0,1e5);C.BHopBV.Velocity=Vector3.new(0,0,0);C.BHopBV.Parent=hp end;local md=h.MoveDirection;local im=md.Magnitude>0.1;local st=h:GetState();local og=(st==Enum.HumanoidStateType.Running or st==Enum.HumanoidStateType.Landed or st==Enum.HumanoidStateType.RunningNoPhysics);if im then local hv=Vector3.new(md.X,0,md.Z);if hv.Magnitude>0.01 then C.BHopBV.Velocity=hv.Unit*S.BHopSpd end;if og and tick()-lj>0.15 then h:ChangeState(Enum.HumanoidStateType.Jumping);lj=tick()end else C.BHopBV.Velocity=Vector3.new(0,0,0)end end);nt("BHop","Включен",2)end
local SpinBot={Enabled=false,Speed=9999}
local function setupSpinBot()sd(C.SpinConn);C.SpinConn=nil;if not SpinBot.Enabled then return end;C.SpinConn=RS.Heartbeat:Connect(function(dt)if not LP.Character then return end;local hp=LP.Character:FindFirstChild("HumanoidRootPart");if hp then hp.CFrame=hp.CFrame*CFrame.Angles(0,math.rad(SpinBot.Speed*dt),0)end end)end
local function setupNoclip(v)if v then if not C.noclipConn then C.noclipConn=RS.Stepped:Connect(function()if not LP.Character then return end;for _,p in ipairs(LP.Character:GetDescendants())do if p:IsA("BasePart")then p.CanCollide=false end end end)end else if C.noclipConn then C.noclipConn:Disconnect();C.noclipConn=nil end end end
local function setupWallHop()sd(C.WallHopConn);C.WallHopConn=nil;if not S.WallHop then return end;C.WallHopConn=RS.Heartbeat:Connect(function()if not LP.Character then return end;local h=LP.Character:FindFirstChildOfClass("Humanoid");if not h then return end;if UIS:IsKeyDown(Enum.KeyCode.Space)then h:ChangeState(Enum.HumanoidStateType.Jumping)end end)end
local function setupAntiFling()sd(C.antiFlingConn);C.antiFlingConn=nil;if not S.AntiFling then return end;C.antiFlingConn=RS.Heartbeat:Connect(function()if not S.AntiFling then return end;for _,p in ipairs(P:GetPlayers())do if p~=LP and p.Character then for _,part in ipairs(p.Character:GetDescendants())do if part:IsA("BasePart")and part.CanCollide then part.CanCollide=false end end end end;local c=LP.Character;if not c then return end;local hp=c:FindFirstChild("HumanoidRootPart");if not hp then return end;if hp.AssemblyLinearVelocity.Magnitude>200 then hp.AssemblyLinearVelocity=Vector3.new(0,0,0)end;if hp.AssemblyAngularVelocity.Magnitude>20 then hp.AssemblyAngularVelocity=Vector3.new(0,0,0)end end)end
local function setupAntiAFK()sd(C.afkConn);C.afkConn=nil;if not S.AntiAFK then return end;local last=0;C.afkConn=RS.Heartbeat:Connect(function()if not LP.Character then return end;local now=tick();if now-last>60 then local h=LP.Character:FindFirstChildOfClass("Humanoid");if h then h.Jump=true;last=now end end end)end
local function createHL(p,col)if not p or not p.Character then return end;local c=p.Character;local h=c:FindFirstChild("SkyHubESP");if not h then h=Instance.new("Highlight");h.Name="SkyHubESP";h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;h.Parent=c end;h.FillColor=col;h.OutlineColor=col;h.FillTransparency=0.4;h.OutlineTransparency=0;h.Enabled=true;C.Highlights[p.UserId]=h end
local function remHL(p)if not p or not p.Character then return end;local h=p.Character:FindFirstChild("SkyHubESP");if h then pcall(function()h:Destroy()end)end;C.Highlights[p.UserId]=nil end
local function clearHL()for _,h in pairs(C.Highlights)do if h then pcall(function()h:Destroy()end)end end;C.Highlights={}end
local function cacheParts(p)if not p or not p.Character then return end;local list={};for _,part in ipairs(p.Character:GetDescendants())do if part:IsA("BasePart")and part.Name~="HumanoidRootPart"then list[part]={ogMat=part.Material,ogCol=part.Color,ogTrans=part.Transparency,ogShadow=part.CastShadow}end end;C.ChamsParts[p.UserId]=list end
local function applyChams(p)if not p or not p.Character then return end;local c=p.Character;if not C.ChamsParts[p.UserId]then cacheParts(p)end;local col=S.ChamsCol;for _,part in ipairs(c:GetDescendants())do if part:IsA("BasePart")and part.Name~="HumanoidRootPart"then if not C.ChamsParts[p.UserId]then C.ChamsParts[p.UserId]={}end;if not C.ChamsParts[p.UserId][part]then C.ChamsParts[p.UserId][part]={ogMat=part.Material,ogCol=part.Color,ogTrans=part.Transparency,ogShadow=part.CastShadow}end;part.Material=Enum.Material.ForceField;part.Color=col;part.Transparency=0.0;part.CastShadow=false end end end
local function remChams(p)if not p or not p.Character then return end;local c=p.Character;local list=C.ChamsParts[p.UserId];if not list then return end;for part,data in pairs(list)do if part and part.Parent then pcall(function()part.Material=data.ogMat;part.Color=data.ogCol;part.Transparency=data.ogTrans;part.CastShadow=data.ogShadow end)end end;C.ChamsParts[p.UserId]=nil end
local function clearAllChams()for uid,_ in pairs(C.ChamsParts)do local p=P:GetPlayerByUserId(uid);if p then remChams(p)end end;C.ChamsParts={}end
local function updateChamsAll()if S.Chams then for _,p in ipairs(P:GetPlayers())do cacheParts(p);applyChams(p)end else clearAllChams()end end
local function createTracer(p)if not p or p==LP then return end;if C.Tracers[p.UserId]then return end;local line=Drawing.new("Line");line.Thickness=2;line.Transparency=0.8;line.Visible=false;line.Color=getRoleCol(p);C.Tracers[p.UserId]=line end
local function updateTracers()if not S.Tracers then for _,line in pairs(C.Tracers)do line.Visible=false end;return end;local center=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y);for uid,line in pairs(C.Tracers)do local p=P:GetPlayerByUserId(uid);if not p or not p.Character then line.Visible=false continue end;local hp=p.Character:FindFirstChild("HumanoidRootPart");if not hp then line.Visible=false continue end;local sp,on=Cam:WorldToViewportPoint(hp.Position);if not on then line.Visible=false continue end;line.From=center;line.To=Vector2.new(sp.X,sp.Y);line.Visible=true;line.Color=getRoleCol(p)end end
local function clearTracers()for uid,line in pairs(C.Tracers)do pcall(function()line:Remove()end)end;C.Tracers={}end
local function createTrail()local c=LP.Character;if not c then return end;local hp=c:FindFirstChild("HumanoidRootPart");if not hp then return end;if C.TrailAttach.trail and C.TrailAttach.trail.Parent then return end;local a1=Instance.new("Attachment");a1.Position=Vector3.new(-1,0,0);a1.Parent=hp;local a2=Instance.new("Attachment");a2.Position=Vector3.new(1,0,0);a2.Parent=hp;local tr=Instance.new("Trail");tr.Attachment0=a1;tr.Attachment1=a2;tr.Lifetime=0.8;tr.MinLength=0;tr.FaceCamera=true;tr.LightEmission=1;tr.LightInfluence=0;tr.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)});tr.Color=ColorSequence.new(S.TrailsCol);tr.Parent=hp;C.TrailAttach={trail=tr,att1=a1,att2=a2}end
local function updateTrailCol()if C.TrailAttach.trail then C.TrailAttach.trail.Color=ColorSequence.new(S.TrailsCol)end end
local function remTrail()if C.TrailAttach.trail then pcall(function()C.TrailAttach.trail:Destroy()end)end;if C.TrailAttach.att1 then pcall(function()C.TrailAttach.att1:Destroy()end)end;if C.TrailAttach.att2 then pcall(function()C.TrailAttach.att2:Destroy()end)end;C.TrailAttach={}end
local function getGroundY(o)local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;local c=LP.Character;if c then ray.FilterDescendantsInstances={c}end;local res=WS:Raycast(o,Vector3.new(0,-50,0),ray);if res then return res.Position.Y end;return o.Y-3 end
local function createJumpCircle(pos)local gy=getGroundY(pos);local rp=Vector3.new(pos.X,gy+0.08,pos.Z);local ring=Instance.new("Part");ring.Shape=Enum.PartType.Cylinder;ring.Size=Vector3.new(0.08,0.5,0.5);ring.Material=Enum.Material.Neon;ring.Color=S.JumpCirclesCol;ring.Transparency=0;ring.Anchored=true;ring.CanCollide=false;ring.CastShadow=false;ring.CFrame=CFrame.new(rp)*CFrame.Angles(0,0,math.rad(90));ring.Parent=WS;local light=Instance.new("PointLight");light.Brightness=4;light.Color=S.JumpCirclesCol;light.Range=20;light.Parent=ring;local t0=tick();local dur=0.7;local conn;conn=RS.Heartbeat:Connect(function()if not ring or not ring.Parent then sd(conn);return end;local p=(tick()-t0)/dur;if p>=1 then pcall(function()ring:Destroy()end);sd(conn);return end;local d=0.5+p*6;ring.Size=Vector3.new(0.08,d,d);ring.Transparency=p;ring.CFrame=CFrame.new(rp)*CFrame.Angles(0,0,math.rad(90));light.Brightness=4*(1-p)end)end
local function updateJumpCircles()if not S.JumpCircles or not LP.Character then return end;local h=LP.Character:FindFirstChildOfClass("Humanoid");local hp=LP.Character:FindFirstChild("HumanoidRootPart");if not h or not hp then return end;local isJump=h:GetState()==Enum.HumanoidStateType.Jumping;if isJump and not C.JumpTrack.wasJump then createJumpCircle(hp.Position)end;C.JumpTrack.wasJump=isJump end
local function setupRGB()sd(C.RGBConn);C.RGBConn=nil;if not S.RGBHum then if LP.Character then for _,p in ipairs(LP.Character:GetDescendants())do if p:IsA("BasePart")then p.Material=Enum.Material.Plastic;p.Color=Color3.fromRGB(255,255,255);p.Transparency=0 end end end;return end;C.RGBConn=RS.Heartbeat:Connect(function()if not LP.Character then return end;local col=Color3.fromHSV(tick()%1,1,1);for _,p in ipairs(LP.Character:GetDescendants())do if p:IsA("BasePart")and p.Name~="HumanoidRootPart"then p.Material=Enum.Material.ForceField;p.Color=col;p.Transparency=0.3 end end end)end
local function setupXRay()if S.XRay then for _,p in ipairs(WS:GetDescendants())do if p:IsA("BasePart")and not p:IsA("Terrain")then C.XRayParts[p]=p.LocalTransparencyModifier;p.LocalTransparencyModifier=0.6 end end else for p,v in pairs(C.XRayParts)do if p and p.Parent then pcall(function()p.LocalTransparencyModifier=v end)end end;C.XRayParts={}end end
local function setupBloom(e)L.Brightness=e and 1.5 or 1 end
local function setupColorCorr(e)L.Ambient=e and S.AuraCol or Color3.fromRGB(0,0,0);L.OutdoorAmbient=e and S.AuraCol or Color3.fromRGB(0,0,0)end
local function setupVignette(e)if e then if C.Post.vignette then return end;local sg=Instance.new("ScreenGui");sg.Name="VignetteEffect";sg.ResetOnSpawn=false;sg.IgnoreGuiInset=true;local f=Instance.new("Frame");f.Size=UDim2.new(1,0,1,0);f.BackgroundColor3=Color3.fromRGB(0,0,0);f.BackgroundTransparency=0.5;f.BorderSizePixel=0;f.Parent=sg;sg.Parent=LP:WaitForChild("PlayerGui");C.Post.vignette=sg else if C.Post.vignette then pcall(function()C.Post.vignette:Destroy()end)end;C.Post.vignette=nil end end
