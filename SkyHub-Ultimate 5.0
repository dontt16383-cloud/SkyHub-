local function setupSky(name)local sb=SKY_ASSETS[name];if not sb then local id=tostring(name):gsub("%s+",""):gsub("rbxassetid://","");if id:match("^%d+$")then local url="rbxassetid://"..id;for _,o in ipairs(L:GetChildren())do if o:IsA("Sky")then o:Destroy()end end;local sky=Instance.new("Sky");sky.SkyboxBk=url;sky.SkyboxDn=url;sky.SkyboxFt=url;sky.SkyboxLf=url;sky.SkyboxRt=url;sky.SkyboxUp=url;sky.Parent=L;nt("Небо","Загружено: "..id,2)else nt("Небо","Неизвестный скибокс",2)end;return end;task.spawn(function()CP:PreloadAsync({sb.Bk,sb.Dn,sb.Ft,sb.Lf,sb.Rt,sb.Up})end);local sky=L:FindFirstChildOfClass("Sky")or Instance.new("Sky");sky.Name="Sky";sky.Parent=L;sky.SkyboxBk=sb.Bk;sky.SkyboxDn=sb.Dn;sky.SkyboxFt=sb.Ft;sky.SkyboxLf=sb.Lf;sky.SkyboxRt=sb.Rt;sky.SkyboxUp=sb.Up;nt("Небо","Загружено: "..name,2)end
local function removeSky()for _,o in ipairs(L:GetChildren())do if o:IsA("Sky")then o:Destroy()end end;nt("Небо","Удалено",2)end
local function applyWeather(p)S.Weather=p;if p=="Clear"then L.FogEnd=100000;L.Brightness=2 elseif p=="Rain"then L.FogEnd=500;L.Brightness=1.5 elseif p=="Fog"then L.FogEnd=80;L.Brightness=1 end end
local function applyCharColor(c)S.CharCol=c;local ch=LP.Character;if ch then for _,p in ipairs(ch:GetDescendants())do if p:IsA("BasePart")and p.Name~="Head"then p.Color=c end end end end
local function toggleGlow(v)S.Glow=v;if v then local ch=LP.Character;if ch then local g=ch:FindFirstChild("SkyHubGlow");if not g then g=Instance.new("Highlight");g.Name="SkyHubGlow";g.FillColor=Color3.fromRGB(0,200,255);g.OutlineColor=Color3.fromRGB(0,220,255);g.FillTransparency=0.65;g.Parent=ch end end else if LP.Character then local g=LP.Character:FindFirstChild("SkyHubGlow");if g then g:Destroy()end end end end
local TV={Brick={Base=Enum.Material.Brick,Tex='rbxassetid://10777285622'},Concrete={Base=Enum.Material.Concrete,Tex='rbxassetid://15622710576'},CorrodedMetal={Base=Enum.Material.CorrodedMetal,Tex='rbxassetid://78612695839404'},Grass={Base=Enum.Material.Grass,Tex='rbxassetid://9267183930'},Metal={Base=Enum.Material.Metal,Tex='rbxassetid://121650613091353'},Sand={Base=Enum.Material.Sand,Tex='rbxassetid://12624140843'},Slate={Base=Enum.Material.Slate,Tex='rbxassetid://8676746437'},Wood={Base=Enum.Material.Wood,Tex='rbxassetid://3258599312'},WoodPlanks={Base=Enum.Material.WoodPlanks,Tex='rbxassetid://8676581022'}}
local TVBM={[Enum.Material.Brick]='Brick',[Enum.Material.Concrete]='Concrete',[Enum.Material.CorrodedMetal]='CorrodedMetal',[Enum.Material.Grass]='Grass',[Enum.Material.Metal]='Metal',[Enum.Material.Sand]='Sand',[Enum.Material.Slate]='Slate',[Enum.Material.Wood]='Wood',[Enum.Material.WoodPlanks]='WoodPlanks'}
local function ensureTexVars()if C.TexBuilt then return end;for n,d in pairs(TV)do local v=MS:FindFirstChild(n);if not v then v=Instance.new('MaterialVariant');v.Name=n;v.Parent=MS end;pcall(function()v.BaseMaterial=d.Base;v.ColorMap=d.Tex;v.MetalnessMap=d.Tex;v.NormalMap=d.Tex;v.RoughnessMap=d.Tex;v.MaterialPattern=Enum.MaterialPattern.Regular;v.StudsPerTile=5 end)end;C.TexBuilt=true end
local function rememberTex(p)if not C.TexState[p]then C.TexState[p]={Color=p.Color,Material=p.Material,Variant=p.MaterialVariant}end;return C.TexState[p]end
local function shouldSkipTex(p)if not p:IsDescendantOf(WS)then return true end;if p.Name=='LarpticWeather' or p.Name=='Part'then return true end;local par=p.Parent;if par and(par:IsA('Tool')or par:IsA('Accessory'))then return true end;local mod=p:FindFirstAncestorOfClass('Model');if mod and P:GetPlayerFromCharacter(mod)then return true end;return false end
local function applyTexPack()if not S.TexturePack then return end;ensureTexVars();for _,o in ipairs(WS:GetDescendants())do if o:IsA('BasePart')and not shouldSkipTex(o)then rememberTex(o);local n=TVBM[o.Material];if n then pcall(function()o.MaterialVariant=n end)end end end end
local function clearTexPack()for p,state in pairs(C.TexState)do if p and p.Parent and state then pcall(function()p.Color=state.Color;p.Material=state.Material;p.MaterialVariant=state.Variant or''end)end end;C.TexState={};for n,_ in pairs(TV)do local v=MS:FindFirstChild(n);if v and v:IsA('MaterialVariant')then pcall(function()v:Destroy()end)end end;C.TexBuilt=false end
local function applyStretch(v)S.Stretch=v;if not v then if C.StretchConn then pcall(function()C.StretchConn:Disconnect()end);C.StretchConn=nil end;pcall(function()workspace.CurrentCamera.CFrame=workspace.CurrentCamera.CFrame end);return end;if not C.StretchConn then C.StretchConn=RS.RenderStepped:Connect(function()local cam=workspace.CurrentCamera;if cam then cam.CFrame=cam.CFrame*CFrame.new(0,0,0,1,0,0,0,S.StretchFact,0,0,0,1)end)end end
local tau=math.pi*2
local function createChinaHatDraw()for i=1,#C.ChinaHatDraw do pcall(function()C.ChinaHatDraw[i][1]:Remove();C.ChinaHatDraw[i][2]:Remove()end)end;C.ChinaHatDraw={};for i=1,25 do C.ChinaHatDraw[i]={Drawing.new('Line'),Drawing.new('Triangle')};C.ChinaHatDraw[i][1].ZIndex=2;C.ChinaHatDraw[i][1].Thickness=2;C.ChinaHatDraw[i][2].ZIndex=1;C.ChinaHatDraw[i][2].Filled=true end end
local function hatRemoveCl()if C.ChinaHatParts[LP.Character]then pcall(function()C.ChinaHatParts[LP.Character]:Destroy()end);C.ChinaHatParts[LP.Character]=nil end end
local function hatAddCl(c)task.wait(0.1);local head=c:WaitForChild("Head",5);if not head then return end;hatRemoveCl();local hat=Instance.new("Part");hat.Name="ChineseHat";hat.Transparency=S.ChinaHatTrans;hat.Color=S.ChinaHatCol;hat.Material=Enum.Material.Neon;hat.CanCollide=false;hat.Reflectance=0;local mesh=Instance.new("SpecialMesh");mesh.MeshId="rbxassetid://1033714";mesh.Scale=Vector3.new(S.ChinaHatRad,S.ChinaHatH,S.ChinaHatRad);mesh.Parent=hat;local weld=Instance.new("WeldConstraint");weld.Part0=head;weld.Part1=hat;weld.Parent=hat;hat.CFrame=head.CFrame*CFrame.new(0,1.1,0);hat.Parent=c;C.ChinaHatParts[c]=hat end
local function hatUpdateCl()for c,h in pairs(C.ChinaHatParts)do if h and h.Parent and c==LP.Character then h.Transparency=S.ChinaHatTrans;h.Reflectance=0;if S.ChinaHatRainbow then h.Color=Color3.fromHSV(tick()%S.ChinaHatRainbowSpd/S.ChinaHatRainbowSpd,1,1)else h.Color=S.ChinaHatCol end;local mesh=h:FindFirstChildOfClass("SpecialMesh");if mesh then mesh.Scale=Vector3.new(S.ChinaHatRad,S.ChinaHatH,S.ChinaHatRad)end end end end
local function hatUpdateDraw()local pass=S.ChinaHat and LP.Character and LP.Character:FindFirstChild('Head')~=nil and(Cam.CFrame.p-Cam.Focus.p).magnitude>1 and LP.Character.Humanoid.Health>0;for i=1,#C.ChinaHatDraw do local line,tri=C.ChinaHatDraw[i][1],C.ChinaHatDraw[i][2];if pass then local col;if S.ChinaHatRainbow then col=Color3.fromHSV((tick()%S.ChinaHatRainbowSpd/S.ChinaHatRainbowSpd-(i/#C.ChinaHatDraw))%1,0.5,1)else col=S.ChinaHatCol end;local pos=LP.Character.Head.Position+Vector3.new(0,0.75,0);local top=pos+Vector3.new(0,0.75,0);local a,b=(i/25)*tau,((i+1)/25)*tau;local lw=pos+(Vector3.new(math.cos(a),0,math.sin(a))*S.ChinaHatRad);local nw=pos+(Vector3.new(math.cos(b),0,math.sin(b))*S.ChinaHatRad);local ls=Cam:WorldToViewportPoint(lw);local ns=Cam:WorldToViewportPoint(nw);local ts=Cam:WorldToViewportPoint(top);line.From=Vector2.new(ls.X,ls.Y);line.To=Vector2.new(ns.X,ns.Y);line.Color=col;line.Transparency=1-S.ChinaHatTrans;line.Visible=true;tri.PointA=Vector2.new(ts.X,ts.Y);tri.PointB=line.From;tri.PointC=line.To;tri.Color=col;tri.Transparency=0.35;tri.Visible=true else line.Visible=false;tri.Visible=false end end end
local function toggleChinaHat(v)S.ChinaHat=v;if v then createChinaHatDraw();if S.ChinaHatStyle=="Classic"and LP.Character then hatAddCl(LP.Character)end;if C.ChinaHatConn then sd(C.ChinaHatConn)end;C.ChinaHatConn=RS.Heartbeat:Connect(function()if S.ChinaHatStyle=="Classic"then hatUpdateCl()else hatUpdateDraw()end end);nt("China Hat","Включен ("..S.ChinaHatStyle..")",2)else hatRemoveCl();for i=1,#C.ChinaHatDraw do pcall(function()C.ChinaHatDraw[i][1].Visible=false;C.ChinaHatDraw[i][2].Visible=false end)end;if C.ChinaHatConn then sd(C.ChinaHatConn);C.ChinaHatConn=nil end;nt("China Hat","Выключен",2)end end
local function hatChangeStyle(v)local was=S.ChinaHat;S.ChinaHatStyle=v;if was then toggleChinaHat(false);task.wait(0.1);toggleChinaHat(true)end;nt("China Hat","Стиль: "..v,2)end
local AURA_IDS={angel="97658130917593",starlight="134645216613107",heavenly="139300897520961",ribbon="132069507632161",sakura="81755778619404",wind="80694081850877",flow="119913533725648",star="73754563740680"};local AURA_ORDER={"angel","starlight","heavenly","ribbon","sakura","wind","flow","star"};local AuraSelected={};for _,n in ipairs(AURA_ORDER)do AuraSelected[n]=false end
local function clearAura()for _,p in ipairs(C.AuraParts)do pcall(function()p:Destroy()end)end;C.AuraParts={}end
local function loadAura(n)if C.AuraCache[n]then return C.AuraCache[n]end;local id=AURA_IDS[n];if not id then return nil end;local ok,res=pcall(game.GetObjects,game,"rbxassetid://"..id);if ok and res and res[1]then C.AuraCache[n]=res[1];return res[1]end;return nil end
local function colorAura(m,col)local seq=ColorSequence.new(col);for _,d in ipairs(m:GetDescendants())do if d:IsA("PointLight")then d.Color=col elseif d:IsA("ParticleEmitter")or d:IsA("Beam")or d:IsA("Trail")then d.Color=seq end end end
local function applyAura()clearAura();if not S.Aura then return end;local c=LP.Character;if not c then return end;for _,n in ipairs(AURA_ORDER)do if AuraSelected[n]then local m=loadAura(n);if m then colorAura(m,S.AuraCol);local cl=m:Clone();for _,p in ipairs(cl:GetChildren())do local t=c:FindFirstChild(p.Name);if t and t:IsA("BasePart")then for _,ch in ipairs(p:GetChildren())do ch.Parent=t;table.insert(C.AuraParts,ch)end end end;cl:Destroy()end end end end
local function toggleAura(v)S.Aura=v;if v then applyAura()else clearAura()end end
local function createOrbiz()if C.OrbizFolder then C.OrbizFolder:Destroy()end;if C.OrbizConn then C.OrbizConn:Disconnect()end;C.OrbizParts={};if not S.Orbiz then return end;local c=LP.Character;if not c then return end;local r=c:FindFirstChild("HumanoidRootPart");if not r then return end;local f=Instance.new("Folder");f.Name="Orbiz3D";f.Parent=WS;C.OrbizFolder=f;local cnt=800;for i=1,cnt do local p=Instance.new("Part");p.Shape=Enum.PartType.Ball;p.Size=Vector3.new(0.2+math.random()*0.3,0.2+math.random()*0.3,0.2+math.random()*0.3);p.BrickColor=BrickColor.new("Bright violet");p.Material=Enum.Material.Neon;p.Transparency=0.2+math.random()*0.5;p.Anchored=true;p.CanCollide=false;p.Parent=f;local range=80;p.Position=r.Position+Vector3.new((math.random()-0.5)*range*2,math.random()*50+20,(math.random()-0.5)*range*2);table.insert(C.OrbizParts,{part=p,speed=0.2+math.random()*0.8,dx=(math.random()-0.5)*0.5,dz=(math.random()-0.5)*0.5,startY=p.Position.Y})end;C.OrbizConn=RS.Heartbeat:Connect(function()if not S.Orbiz then return end;local rp=r and r.Position or Vector3.new(0,0,0);local range=80;for _,data in pairs(C.OrbizParts)do local p=data.part;if not p or not p.Parent then continue end;local pos=p.Position;pos=pos-Vector3.new(0,data.speed*0.08,0);pos=pos+Vector3.new(data.dx*0.03,0,data.dz*0.03);if pos.Y<rp.Y-10 then pos=Vector3.new(rp.X+(math.random()-0.5)*range*2,rp.Y+30+math.random()*40,rp.Z+(math.random()-0.5)*range*2);p.Transparency=0.2+math.random()*0.5;p.Size=Vector3.new(0.2+math.random()*0.4,0.2+math.random()*0.4,0.2+math.random()*0.4)end;p.Position=pos end end)end
local function toggleOrbiz(v)S.Orbiz=v;createOrbiz();nt("Орбизы",v and"Включены"or"Выключены",2)end
local function getClosestMurderFov()local center=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2);local best,bd=nil,math.huge;for _,p in ipairs(P:GetPlayers())do if p==LP then continue end;if not hasKnife(p)then continue end;if not p.Character then continue end;local hp=p.Character:FindFirstChild("HumanoidRootPart");if not hp then continue end;local sp,on=Cam:WorldToScreenPoint(hp.Position);if not on or sp.Z<0 then continue end;local d=(center-Vector2.new(sp.X,sp.Y)).Magnitude;if d<=S.FovRad and d<bd then bd=d;best=p end end;return best end
local function createFovCircle()if C.FovCircle then pcall(function()C.FovCircle:Remove()end)end;local c=Drawing.new("Circle");c.Radius=S.FovRad;c.Color=Color3.fromRGB(255,255,255);c.Thickness=1.5;c.Transparency=0.7;c.Filled=false;c.Visible=false;c.NumSides=64;C.FovCircle=c end
local function setupFovAimbot()sd(C.FovConn);C.FovConn=nil;if C.FovCircle then C.FovCircle.Visible=false end;if not S.FovAimbot then return end;if not C.FovCircle then createFovCircle()end;local c=C.FovCircle;C.FovConn=RS.RenderStepped:Connect(function()if not S.FovAimbot then c.Visible=false;return end;local center=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2);c.Position=center;c.Radius=S.FovRad;c.Visible=true;local t=getClosestMurderFov();if t then c.Color=Color3.fromRGB(255,50,50);c.Thickness=2.0;local hp=t.Character:FindFirstChild("HumanoidRootPart");if hp then local vel=hp.AssemblyLinearVelocity;local pred=hp.Position+(vel*0.1);Cam.CFrame=CFrame.lookAt(Cam.CFrame.Position,pred,Cam.CFrame.UpVector)end else c.Color=Color3.fromRGB(255,255,255);c.Thickness=1.5 end end)end
local function killPlayer(t)if not t or not t.Character then return end;local h=t.Character:FindFirstChildOfClass("Humanoid");if h then h.Health=0 end end
local function findKillRemote()for _,ch in ipairs(ReS:GetDescendants())do if ch:IsA("RemoteEvent")then local n=ch.Name:lower();if n:find("kill")or n:find("attack")or n:find("damage")or n:find("murder")or n:find("slash")or n:find("stab")then C.KillAllRemote=ch;return end end end;for _,ch in ipairs(ReS:GetDescendants())do if ch:IsA("RemoteEvent")then C.KillAllRemote=ch;return end end end
local function killAllPlayers()if not C.KillAllRemote then return end;for _,p in ipairs(P:GetPlayers())do if p~=LP and p.Character and p.Character:FindFirstChild("Humanoid")and p.Character.Humanoid.Health>0 then pcall(function()C.KillAllRemote:FireServer(p)end);pcall(function()C.KillAllRemote:FireServer(p.Character)end);pcall(function()C.KillAllRemote:FireServer(p.Character.HumanoidRootPart)end)end end end
local function toggleKillAll(v)S.KillAll=v;if v then if not C.KillAllRemote then findKillRemote()end;sd(C.KillAllConn);C.KillAllConn=RS.Stepped:Connect(function()if S.KillAll then killAllPlayers()end end);nt("Kill All","Включен",2)else sd(C.KillAllConn);nt("Kill All","Выключен",2)end end
local function sheriffAutoShootLoop()while S.SheriffAutoShoot do task.wait(0.03);if not LP.Character then continue end;if not hasGun(LP)then continue end;local myHP=LP.Character:FindFirstChild("HumanoidRootPart");if not myHP then continue end;local t,td=nil,math.huge;for _,p in ipairs(P:GetPlayers())do if p==LP then continue end;if not p.Character then continue end;if not hasKnife(p)then continue end;local tp=p.Character:FindFirstChild("Head")or p.Character:FindFirstChild("HumanoidRootPart");if not tp then continue end;local d=(myHP.Position-tp.Position).Magnitude;if d<td and d<=100 then td=d;t=p end end;if t then local tp=t.Character:FindFirstChild("Head")or t.Character:FindFirstChild("HumanoidRootPart");if tp then local targetPos=tp.Position;if S.AimPredict then local vel=tp.AssemblyLinearVelocity;targetPos=targetPos+(vel*0.12)end;local cur=Cam.CFrame.Position;local look=CFrame.lookAt(cur,targetPos);if S.AimSmooth<1 then local smooth=cur+(look.Position-cur)*S.AimSmooth;Cam.CFrame=CFrame.lookAt(smooth,targetPos)else Cam.CFrame=look end;pcall(function()VIM:SendKeyEvent(true,Enum.KeyCode.MouseButton1,false,game);task.wait(0.05);VIM:SendKeyEvent(false,Enum.KeyCode.MouseButton1,false,game)end);task.wait(0.25)end end end end
local function toggleSheriffAutoShoot(v)S.SheriffAutoShoot=v;sd(C.SheriffAutoShootConn);C.SheriffAutoShootConn=nil;if v then C.SheriffAutoShootConn=task.spawn(sheriffAutoShootLoop);nt("Sheriff AutoShoot","Включен",2)else nt("Sheriff AutoShoot","Выключен",2)end end
local function flingPlayer(t)if not t or not t.Character then return end;local root=t.Character:FindFirstChild("HumanoidRootPart");if not root then return end;local bv=Instance.new("BodyVelocity");bv.MaxForce=Vector3.new(1e5,1e5,1e5);bv.Velocity=Vector3.new(0,150,0);bv.Parent=root;task.delay(0.4,function()if bv then bv:Destroy()end end);nt("Флинг","Выбиваем "..t.Name,2)end
local function flingAll()for _,p in ipairs(P:GetPlayers())do if p~=LP then flingPlayer(p)end end end
local function grabGunImproved()if C.GrabGunRun then return end;if not LP.Character then return end;local c=LP.Character;local hp=c:FindFirstChild("HumanoidRootPart");if not hp then return end;if hasKnife(LP)then nt("Grab Gun","Ты убийца, пушка не нужна!",2);return end;local function hasGunNow()return hasGun(LP)end;if hasGunNow()then nt("Grab Gun","У тебя уже есть пушка!",2);return end;local drop=WS:FindFirstChild("GunDrop",true)or WS:FindFirstChild("DroppedGun",true);local handle=drop and(drop:FindFirstChild("Handle",true)or drop:FindFirstChildOfClass("Part",true)or drop);if not handle then nt("Grab Gun","Пушки нет на карте!",2);return end;C.GrabGunRun=true;local orig=hp.CFrame;local target=handle:IsA("Model")and handle:GetPivot()or handle.CFrame;hp.CFrame=target*CFrame.new(0,-1,0);if firetouchinterest then pcall(function()firetouchinterest(hp,handle,0);task.wait(0.02);firetouchinterest(hp,handle,1)end)end;task.wait(0.15);if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")then hp.CFrame=orig end;task.wait(0.1);if hasGunNow()then nt("Grab Gun","Пушка подобрана!",2)else nt("Grab Gun","Не удалось подобрать пушку!",2)end;C.GrabGunRun=false end
local function tpToPlayer(p)if not p or not p.Character then return end;local hp=p.Character:FindFirstChild("HumanoidRootPart");if not hp then return end;if not LP.Character then return end;local my=LP.Character:FindFirstChild("HumanoidRootPart");if my then my.CFrame=hp.CFrame*CFrame.new(0,3,2)end end
local function tpToRole(r)if not LP.Character then return end;local my=LP.Character:FindFirstChild("HumanoidRootPart");if not my then return end;local t,td=nil,math.huge;for _,p in ipairs(P:GetPlayers())do if p==LP then continue end;if(r=="Murder"and hasKnife(p))or(r=="Sheriff"and hasGun(p))then local hp=p.Character:FindFirstChild("HumanoidRootPart");if hp then local d=(my.Position-hp.Position).Magnitude;if d<td then td=d;t=p end end end end;if t then tpToPlayer(t);nt("Телепорт","Tp к "..r,2)else nt("Телепорт",r.." не найден",2)end end
