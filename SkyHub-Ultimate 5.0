local function applyTheme(name)
    local themes = {
        Dark = { Main = Color3.fromRGB(18, 18, 22), Card = Color3.fromRGB(25, 25, 31), Accent = Color3.fromRGB(90, 90, 100) },
        Blue = { Main = Color3.fromRGB(14, 20, 30), Card = Color3.fromRGB(20, 30, 45), Accent = Color3.fromRGB(40, 130, 255) },
        Purple = { Main = Color3.fromRGB(18, 14, 27), Card = Color3.fromRGB(28, 20, 42), Accent = Color3.fromRGB(145, 70, 255) },
        Green = { Main = Color3.fromRGB(14, 25, 18), Card = Color3.fromRGB(20, 38, 26), Accent = Color3.fromRGB(60, 210, 110) },
        Red = { Main = Color3.fromRGB(27, 15, 17), Card = Color3.fromRGB(40, 20, 23), Accent = Color3.fromRGB(230, 65, 75) },
        Gray = { Main = Color3.fromRGB(28, 28, 28), Card = Color3.fromRGB(38, 38, 38), Accent = Color3.fromRGB(160, 160, 160) },
    }
    local t = themes[name] or themes.Purple
    Main.BackgroundColor3 = t.Main
    Header.BackgroundColor3 = t.Card
    TabBar.BackgroundColor3 = t.Card
    ContentArea.BackgroundColor3 = t.Card
    Theme.Accent = t.Accent
    Theme.Main = t.Main
    Theme.Card = t.Card
end

