local function refreshPlayers()for _,o in ipairs(plFrame:GetChildren())do if o:IsA("TextButton")then o:Destroy()end end;for _,p in ipairs(P:GetPlayers())do if p~=LP then local b=Instance.new("TextButton");b.Size=UDim2.new(1,-10,0,26);b.BackgroundColor3=Theme.Element;b.Text=p.Name;b.TextColor3=Theme.Text;b.TextSize=12;b.Font=F;b.Parent=plFrame;b.MouseButton1Click:Connect(function()S.Selected=p;nt("Выбор","Выбран: "..p.Name,2)end)end end end;refreshPlayers();P.PlayerAdded:Connect(refreshPlayers);P.PlayerRemoving:Connect(refreshPlayers)
