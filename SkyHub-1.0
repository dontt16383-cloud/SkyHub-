    {id = "AutoFarm", icon = "💰", textKey = "tabAutoFarm"},
    {id = "Troll", icon = "🎭", textKey = "tabTroll"},
    {id = "Combat", icon = "⚔", textKey = "tabCombat"},
    {id = "Settings", icon = "⚙", textKey = "tabSettings"},
    {id = "Bio", icon = "✉", textKey = "tabBio"}
}
local tabButtons = {}
local activeTab = "Player"

local function createTabButton(tabData, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 38)
    btn.Position = UDim2.new(0, 3, 0, 3 + (index-1)*44)
    btn.BackgroundColor3 = Color3.fromRGB(40,40,60)
    btn.BackgroundTransparency = 0.4
    btn.Text = tabData.icon .. " " .. getText(tabData.textKey)
    btn.TextColor3 = Color3.new(0.8,0.8,0.9)
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = buttonContainer
    Instance.new("UICorner").Parent = btn
    btn.MouseEnter:Connect(function()
        if activeTab ~= tabData.id then
            btn.BackgroundColor3 = Color3.fromRGB(55,55,80)
            btn.TextColor3 = Color3.new(1,1,1)
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab ~= tabData.id then
            btn.BackgroundColor3 = Color3.fromRGB(40,40,60)
            btn.TextColor3 = Color3.new(0.8,0.8,0.9)
        end
    end)
    btn.MouseButton1Click:Connect(function()
        setActiveTab(tabData.id)
    end)
    tabButtons[tabData.id] = btn
    return btn
end

for i, tab in ipairs(tabs) do
    createTabButton(tab, i)
end
scrollFrameSide.CanvasSize = UDim2.new(0, 0, 0, 3 + #tabs * 44 + 10)

