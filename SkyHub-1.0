-- ===== ФУНКЦИЯ СОЗДАНИЯ ЛОГОТИПА =====
local function createLogo(parent, size, position)
    local container = Instance.new("Frame")
    container.Size = size
    container.Position = position
    container.BackgroundTransparency = 1
    container.Parent = parent
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(30, 20, 60)
    bg.Parent = container
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(1, 0)
    bgCorner.Parent = bg
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 50, 200)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 20, 120))
    })
    grad.Rotation = 45
    grad.Parent = bg
    local border = Instance.new("Frame")
    border.Size = UDim2.new(1, -4, 1, -4)
    border.Position = UDim2.new(0, 2, 0, 2)
    border.BackgroundTransparency = 1
    border.Parent = container
    local borderCorner = Instance.new("UICorner")
    borderCorner.CornerRadius = UDim.new(1, 0)
    borderCorner.Parent = border
    local borderStroke = Instance.new("UIStroke")
    borderStroke.Color = Color3.fromRGB(200, 150, 255)
    borderStroke.Thickness = 2
    borderStroke.Transparency = 0.5
    borderStroke.Parent = border
    local letter = Instance.new("TextLabel")
    letter.Size = UDim2.new(0.7, 0, 0.7, 0)
    letter.Position = UDim2.new(0.15, 0, 0.1, 0)
    letter.BackgroundTransparency = 1
    letter.Text = "S"
    letter.TextColor3 = Color3.new(1, 1, 1)
    letter.Font = Enum.Font.GothamBold
    letter.TextSize = size.Y.Offset * 0.6
    letter.TextScaled = true
    letter.Parent = container
    return container
end

-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =====
local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("Humanoid")
end

local function getRootPart()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function updateInvisibility(part)
    if part:IsA("BasePart") then
        part.Transparency = isInvisible and 1 or 0
    end
end

local function applyPlayerSettings()
    local humanoid = getHumanoid()
    if not humanoid then return end
    humanoid.WalkSpeed = currentWalk
    humanoid.JumpPower = infinityJump and 9999 or currentJump
    humanoid.Scale = currentScale
    if innocentGodMode then
        humanoid.MaxHealth = 9e9
        humanoid.Health = 9e9
        humanoid.BreakJointsOnDeath = false
    else
        humanoid.MaxHealth = 100
        humanoid.BreakJointsOnDeath = true
    end
    local char = LocalPlayer.Character
    if not char then return end
    for _, child in ipairs(char:GetDescendants()) do
        updateInvisibility(child)
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not noclipEnabled
        end
    end
end

local function setupInvisibilityTracker(character)
    character.DescendantAdded:Connect(function(part)
        if isInvisible then updateInvisibility(part) end
        if noclipEnabled and part:IsA("BasePart") then
            part.CanCollide = false
        end
    end)
end

-- ===== ПОЛЁТ =====
local function startFly()
    local root = getRootPart()
    local humanoid = getHumanoid()
    if not root or not humanoid then return end
    if flyBV then flyBV:Destroy() end
    if flyGyro then flyGyro:Destroy() end
    if flyConn then flyConn:Disconnect() end
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1, 1, 1) * 1e6
    flyBV.Velocity = Vector3.new(0, 0, 0)
    flyBV.Parent = root
    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(1, 1, 1) * 1e6
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    flyConn = RunService.Heartbeat:Connect(function(dt)
        if not flyEnabled or not root or not root.Parent then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local cf = cam.CFrame
        local forward = cf.LookVector * Vector3.new(1,0,1)
        if forward.Magnitude < 0.01 then forward = Vector3.new(1,0,0) end
        forward = forward.Unit
        local right = cf.RightVector * Vector3.new(1,0,1)
        if right.Magnitude < 0.01 then right = Vector3.new(1,0,0) end
        right = right.Unit
        local up = Vector3.new(0,1,0)
        local move = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert = 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vert = -1 end
        if move.Magnitude > 0 then move = move.Unit * flySpeed end
        local vel = move + up * vert * flySpeed * 0.8
        flyBV.Velocity = vel
        if flyAnimation then
            flyPulse = (flyPulse or 0) + dt * 2
            flyBV.Velocity = flyBV.Velocity + Vector3.new(0, math.sin(flyPulse) * 0.6, 0)
        end
    end)
end

local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
    end
end

-- ===== NOCLIP =====
local function updateNoclip()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not noclipEnabled
        end
    end
end

-- ===== ВИЗУАЛ =====
local function applySkybox(preset)
    skyPreset = preset
    local sky = Lighting:FindFirstChild("Sky") or Instance.new("Sky")
    sky.Parent = Lighting
    local ids = {
        Default = "rbxasset://textures/sky/skybox/",
        Sunset = "rbxassetid://189338394",
        Night = "rbxassetid://189338466",
        Space = "rbxassetid://189338532"
    }
    local id = ids[preset] or ids.Default
    if preset == "Default" then
        for _, d in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do
            sky["Skybox"..d] = id .. "sky"..d..".tex"
        end
    else
        for _, d in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do
            sky["Skybox"..d] = id
        end
    end
end

local function applyWeather(preset)
    weatherPreset = preset
    local fogEnd = {Clear=1000, Rain=300, Foggy=150}
    local fogStart = {Clear=0, Rain=50, Foggy=10}
    local bright = {Clear=1, Rain=0.6, Foggy=0.8}
    local ambient = {Clear=Color3.new(0.5,0.5,0.5), Rain=Color3.new(0.3,0.3,0.4), Foggy=Color3.new(0.6,0.6,0.7)}
    local climate = {Clear=Enum.Climate.Default, Rain=Enum.Climate.Rainy, Foggy=Enum.Climate.Foggy}
    Lighting.FogEnd = fogEnd[preset] or 1000
    Lighting.FogStart = fogStart[preset] or 0
    Lighting.Brightness = bright[preset] or 1
    Lighting.Ambient = ambient[preset] or Color3.new(0.5,0.5,0.5)
    Lighting.Climate = climate[preset] or Enum.Climate.Default
end

local function applyTimeOfDay(value)
    timeOfDay = value
    Lighting.ClockTime = value
end

local function applyCharacterColor(color)
    characterColor = color
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "Head" then
                part.Color = color
            end
        end
    end
end

local function updateGlow()
    if glowObject then glowObject:Destroy(); glowObject = nil end
    if not glowEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end
    glowObject = Instance.new("PointLight")
    glowObject.Parent = torso
    glowObject.Color = Color3.new(0,1,1)
    glowObject.Brightness = 2
    glowObject.Range = 10
    glowObject.Enabled = true
end

-- ===== ESP =====
local function getPlayerRole(player)
    if player == LocalPlayer then return nil end
    if player.Team then
        local n = player.Team.Name
        if n == "Murderer" or n == "Murder" then return "Murder"
        elseif n == "Sheriff" or n == "Sheriffs" then return "Sheriff"
        else return "Innocent" end
    end
    if player.TeamColor then
        local c = player.TeamColor.Color
        if c == Color3.new(1,0,0) then return "Murder"
        elseif c == Color3.new(0,0,1) then return "Sheriff" end
    end
    return "Innocent"
end

local function updatePlayerHighlight(player)
    if player == LocalPlayer then return end
    if not espPlayersEnabled then
        if playerHighlights[player] then
            playerHighlights[player]:Destroy()
            playerHighlights[player] = nil
        end
        return
    end
    local ch = player.Character
    if not ch then return end
    if playerHighlights[player] then
        playerHighlights[player]:Destroy()
        playerHighlights[player] = nil
    end
    local role = getPlayerRole(player)
    local colors = {Murder=Color3.new(1,0,0), Sheriff=Color3.new(0,0,1), Innocent=Color3.new(0,1,0)}
    local hl = Instance.new("Highlight")
    hl.Parent = ch
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = colors[role] or Color3.new(0,1,0)
    hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.4
    playerHighlights[player] = hl
end

local function refreshAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do updatePlayerHighlight(p) end
end

local function updateGunHighlight(obj)
    if not espGunEnabled then
        if gunHighlights[obj] then gunHighlights[obj]:Destroy(); gunHighlights[obj] = nil end
        return
    end
    if obj:IsA("Tool") or obj:IsA("Model") then
        local n = obj.Name:lower()
        if n:find("gun") or n:find("pistol") or n:find("weapon") then
            local par = obj.Parent
            if par and par:FindFirstChild("Humanoid") then return end
            if obj:IsDescendantOf(workspace) and not obj:IsDescendantOf(LocalPlayer.Character) then
                if gunHighlights[obj] then gunHighlights[obj]:Destroy(); gunHighlights[obj] = nil end
                local hl = Instance.new("Highlight")
                hl.Parent = obj
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillColor = Color3.new(1,1,0)
                hl.OutlineColor = Color3.new(1,1,0)
                hl.FillTransparency = 0.3
                gunHighlights[obj] = hl
            end
        end
    end
end

local function scanExistingGuns()
    for _, o in ipairs(workspace:GetDescendants()) do updateGunHighlight(o) end
end

-- ===== TELEPORT & FLING (используются также в Combat) =====
local function getOtherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(list, p) end
    end
    return list
end

local function findPlayerByRole(role)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getPlayerRole(p) == role then
            return p
        end
    end
    return nil
end

local function teleportToPlayer(player)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not root then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
    if myRoot then
        myRoot.CFrame = root.CFrame + Vector3.new(0, 3, 0)
    end
end

local function teleportToLobby()
    if lobbyPosition then
        local myChar = LocalPlayer.Character
        if myChar then
            local root = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
            if root then root.CFrame = lobbyPosition end
        end
    end
end

local function teleportToMap()
    if mapPosition then
        local myChar = LocalPlayer.Character
        if myChar then
            local root = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
            if root then root.CFrame = mapPosition end
        end
    else
        local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Baseplate")
        if map and map:IsA("BasePart") then
            mapPosition = map.CFrame
            teleportToMap()
        end
    end
end

local function flingPlayer(player, force)
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        if root then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1,1,1) * 1e6
            bv.Velocity = force
            bv.Parent = root
            task.wait(0.3)
            bv:Destroy()
        end
    end
end

local function flingAllPlayers(force)
    for _, p in ipairs(getOtherPlayers()) do
        flingPlayer(p, force)
    end
end

-- ===== ФУНКЦИИ ДЛЯ COMBAT =====
local function findClosestPlayer(roleFilter)
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    local best = nil
    local bestDist = math.huge
    for _, p in ipairs(getOtherPlayers()) do
        if roleFilter and getPlayerRole(p) ~= roleFilter then continue end
        local char = p.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if root then
                local pos, onScreen = camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local dist = (root.Position - camera.CFrame.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = p
                    end
                end
            end
        end
    end
    return best
end

local function aimbot(target)
    if not target then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local char = target.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not root then return end
    local head = char:FindFirstChild("Head") or root
    local targetPos = head.Position
    local currentCF = camera.CFrame
    local targetCF = CFrame.new(currentCF.Position, targetPos)
    local smoothFactor = math.clamp(1 / (sheriffSmoothness + 1), 0.05, 1)
    local newCF = currentCF:Lerp(targetCF, smoothFactor)
    camera.CFrame = newCF
end

local function triggerBot()
    local mouse = game:GetService("Players").LocalPlayer:GetMouse()
    if mouse then
        mouse:Button1Down()
        task.wait(0.05)
        mouse:Button1Up()
    end
end

local function killPlayer(player)
    local char = player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.Health = 0
        end
    end
end

local function killAllPlayers()
    for _, p in ipairs(getOtherPlayers()) do
        killPlayer(p)
    end
end

-- ===== ФУНКЦИИ ДЛЯ AUTOFARM =====
local function getClosestCoin()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not root then return nil end
    local best = nil
    local bestDist = math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("coin") or obj.Name:lower():find("money")) then
            local dist = (obj.Position - root.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                best = obj
            end
        end
    end
    return best
end

local function collectCoin()
    local coin = getClosestCoin()
    if coin then
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if root then
                root.CFrame = coin.CFrame + Vector3.new(0, 2, 0)
                coinsFarmed = coinsFarmed + 1
            end
        end
    end
end

local function startAutoFarm()
    if farmConnection then farmConnection:Disconnect() end
    farmConnection = RunService.Heartbeat:Connect(function()
        if autoFarmEnabled then collectCoin() end
    end)
end

local function stopAutoFarm()
    if farmConnection then farmConnection:Disconnect(); farmConnection = nil end
end

-- ===== ФУНКЦИИ ДЛЯ TROLL =====
local function playEmote(emoteName)
    local humanoid = getHumanoid()
    if humanoid then pcall(function() humanoid:PlayEmote(emoteName) end) end
end

local animIds = {
    ["T-Pose"] = "rbxassetid://5598284032",
    ["Zombie"] = "rbxassetid://6162184239",
    ["Robot"] = "rbxassetid://6162187066",
    ["Floss"] = "rbxassetid://6162190332",
    ["Sit"] = "rbxassetid://180436356",
    ["Point"] = "rbxassetid://180436356",
}

local function playAnimation(animName)
    local humanoid = getHumanoid()
    if not humanoid then return end
    if animTrack then animTrack:Stop(); animTrack:Destroy() end
    local id = animIds[animName]
    if id then
        local anim = Instance.new("Animation")
        anim.AnimationId = id
        local track = humanoid:LoadAnimation(anim)
        track:Play()
        animTrack = track
    end
end

local function toggleKorblox(state)
    korbloxEnabled = state
    local char = LocalPlayer.Character
    if not char then return end
    local leftLeg = char:FindFirstChild("LeftLeg")
    if leftLeg then leftLeg.Transparency = state and 1 or 0 end
end

local function toggleHeadless(state)
    headlessEnabled = state
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head then head.Transparency = state and 1 or 0 end
end

local function toggleJerk(state)
    jerkEnabled = state
    if jerkConnection then jerkConnection:Disconnect(); jerkConnection = nil end
    if state then
        jerkConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local arm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
            if arm and arm:IsA("BasePart") then
                local origCF = arm.CFrame
                local offset = Vector3.new(math.random(-2,2)*0.1, math.random(-2,2)*0.1, math.random(-2,2)*0.1)
                arm.CFrame = origCF + offset
                task.wait(0.05)
                arm.CFrame = origCF
            end
        end)
    end
end

