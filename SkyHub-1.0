    sizeMinus.Font = Enum.Font.GothamBold
    sizeMinus.TextSize = 16
    sizeMinus.Parent = sizeRow
    Instance.new("UICorner").Parent = sizeMinus
    local sizeDisplay = Instance.new("TextLabel")
    sizeDisplay.Size = UDim2.new(0.2, 0, 0.8, 0)
    sizeDisplay.Position = UDim2.new(0.16, 0, 0.1, 0)
    sizeDisplay.BackgroundTransparency = 1
    sizeDisplay.Text = "100%"
    sizeDisplay.TextColor3 = Color3.new(1,1,1)
    sizeDisplay.Font = Enum.Font.Gotham
    sizeDisplay.TextSize = 13
    sizeDisplay.Parent = sizeRow
    local sizePlus = Instance.new("TextButton")
    sizePlus.Size = UDim2.new(0.12, 0, 0.8, 0)
    sizePlus.Position = UDim2.new(0.38, 0, 0.1, 0)
    sizePlus.Text = getText("increase")
    sizePlus.TextColor3 = Color3.new(1,1,1)
    sizePlus.BackgroundColor3 = Color3.fromRGB(60,60,80)
    sizePlus.Font = Enum.Font.GothamBold
    sizePlus.TextSize = 16
    sizePlus.Parent = sizeRow
    Instance.new("UICorner").Parent = sizePlus
    local function updateMenuScale(newScale)
        newScale = math.clamp(newScale, 0.6, 1.5)
        menuScale = newScale
        frame.Size = UDim2.new(0, 480 * menuScale, 0, 580 * menuScale)
        frame.Position = UDim2.new(0.5, -240 * menuScale, 0.5, -290 * menuScale)
        sizeDisplay.Text = string.format("%.0f%%", menuScale * 100)
    end
    sizeMinus.MouseButton1Click:Connect(function() updateMenuScale(menuScale - 0.1) end)
    sizePlus.MouseButton1Click:Connect(function() updateMenuScale(menuScale + 0.1) end)
    y = y + 36
    return y
end)

