        b.Size = UDim2.new(0.13, 0, 0.8, 0)
        b.Position = UDim2.new(0.02 + (0.13+0.02)*(i-1), 0, 0.1, 0)
        b.BackgroundColor3 = c[1]
        b.Text = (menuLanguage == "ru") and c[2] or c[2]
        b.TextColor3 = (c[1] == Color3.new(1,1,1)) and Color3.new(0.2,0.2,0.2) or Color3.new(1,1,1)
        b.Font = Enum.Font.Gotham
        b.TextSize = 8
        b.Parent = colorRow
        Instance.new("UICorner").Parent = b
        b.MouseButton1Click:Connect(function()
            applyCharacterColor(c[1])
            for _, btn in ipairs(colorRow:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.BackgroundTransparency = (btn.BackgroundColor3 == c[1]) and 0.3 or 0
                end
            end
        end)
    end
    y = y + 36

    createToggleRow(parent, getText("glow"), y, glowEnabled, function(s) glowEnabled = s; updateGlow() end)
    y = y + 38
    return y
end)

