    colorLabel.BackgroundTransparency = 1
    colorLabel.Text = getText("charColor")
    colorLabel.TextColor3 = Color3.new(0.9,0.9,1)
    colorLabel.Font = Enum.Font.GothamBold
    colorLabel.TextSize = 14
    colorLabel.TextXAlignment = Enum.TextXAlignment.Left
    colorLabel.Parent = parent
    y = y + 32
    local colorRow = Instance.new("Frame")
    colorRow.Size = UDim2.new(1, -5, 0, 30)
    colorRow.Position = UDim2.new(0, 2, 0, y)
    colorRow.BackgroundTransparency = 1
    colorRow.Parent = parent
    local cols = {
        {Color3.new(1,1,1), "Белый"},
        {Color3.new(1,0,0), "Красный"},
        {Color3.new(0,1,0), "Зелёный"},
        {Color3.new(0,0,1), "Синий"},
        {Color3.new(1,1,0), "Жёлтый"},
        {Color3.new(1,0,1), "Фиолет"}
    }
    for i,c in ipairs(cols) do
