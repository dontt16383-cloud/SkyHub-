-- ===== ОБРАБОТЧИКИ =====
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.3)
    applyPlayerSettings()
    applyCharacterColor(characterColor)
    updateGlow()
    setupInvisibilityTracker(char)
    if flyEnabled then startFly() end
    if noclipEnabled then updateNoclip() end
    if headlessEnabled then toggleHeadless(true) end
    if korbloxEnabled then toggleKorblox(true) end
    savePositions()
end)

if LocalPlayer.Character then
    setupInvisibilityTracker(LocalPlayer.Character)
    savePositions()
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.3)
        updatePlayerHighlight(p)
    end)
    if espPlayersEnabled then
        task.wait(0.5)
        updatePlayerHighlight(p)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if playerHighlights[p] then
        playerHighlights[p]:Destroy()
        playerHighlights[p] = nil
    end
end)

workspace.DescendantAdded:Connect(function(o)
    if espGunEnabled then updateGunHighlight(o) end
end)

applySkybox(skyPreset)
applyWeather(weatherPreset)
applyTimeOfDay(timeOfDay)
task.wait(0.5)
applyPlayerSettings()
applyCharacterColor(characterColor)
updateGlow()

print("SkyHub Premium (с AutoFarm и Troll) загружен! By dont16383")
