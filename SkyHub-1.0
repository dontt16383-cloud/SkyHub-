end)

-- ===== AUTOFARM =====
addToContainer("AutoFarm", function(parent, y)
    createToggleRow(parent, getText("autoFarmCoins"), y, false, function(s)
        autoFarmEnabled = s
        if s then startAutoFarm() else stopAutoFarm() end
    end)
    y = y + 38

    local coinsLabel = Instance.new("TextLabel")
    coinsLabel.Size = UDim2.new(1, 0, 0, 28)
    coinsLabel.Position = UDim2.new(0, 0, 0, y)
    coinsLabel.BackgroundTransparency = 1
    coinsLabel.Text = getText("coinsEarned") .. "0"
    coinsLabel.TextColor3 = Color3.new(0.9,0.9,1)
    coinsLabel.Font = Enum.Font.Gotham
    coinsLabel.TextSize = 14
    coinsLabel.Parent = parent
    -- Обновлять каждую секунду
    local coinsUpdater
    coinsUpdater = RunService.Heartbeat:Connect(function()
        if coinsLabel then
            coinsLabel.Text = getText("coinsEarned") .. tostring(coinsFarmed)
        end
    end)
    parent._coinsUpdater = coinsUpdater
    y = y + 34

    createToggleRow(parent, getText("autoWin"), y, false, function(s)
        autoWinEnabled = s
        if s then
            isInvisible = true
            noclipEnabled = true
            applyPlayerSettings()
            updateNoclip()
        else
            isInvisible = DEFAULT_INVISIBLE
            noclipEnabled = false
            applyPlayerSettings()
            updateNoclip()
        end
    end)
    y = y + 38
    return y
end)

