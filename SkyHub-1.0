}
local currentSong = nil
local soundObj = nil

local function playSong(songName)
    if soundObj then soundObj:Destroy(); soundObj = nil end
    local id = songs[songName]
    if id then
        soundObj = Instance.new("Sound")
        soundObj.SoundId = id
        soundObj.Parent = game:GetService("CoreGui")
        soundObj:Play()
        currentSong = songName
    end
end

