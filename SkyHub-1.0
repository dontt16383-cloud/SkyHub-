    container.BackgroundTransparency = 1
    container.Visible = (tab.id == "Player")
    container.Parent = content
    
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -10, 1, -5)
    scroll.Position = UDim2.new(0, 5, 0, 5)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = Color3.new(1,1,1)
    scroll.ScrollBarImageTransparency = 0.5
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Parent = container
    
    local inner = Instance.new("Frame")
    inner.Size = UDim2.new(1, 0, 0, 0)
    inner.BackgroundTransparency = 1
    inner.Parent = scroll
    
    tabContainers[tab.id] = {container=container, scroll=scroll, inner=inner, currentY=5}
end

-- ===== КОНТРОЛЫ =====
local function createNumberRow(parent, labelText, yPos, minVal, maxVal, step, defaultValue, valueType, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -5, 0, 32)
    row.Position = UDim2.new(0, 2, 0, yPos)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(0.9,0.9,1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.1, 0, 0.7, 0)
    box.Position = UDim2.new(0.58, 0, 0.15, 0)
    box.BackgroundColor3 = Color3.fromRGB(45,45,60)
    box.TextColor3 = Color3.new(1,1,1)
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.Text = tostring(defaultValue)
    box.ClearTextOnFocus = false
    box.Parent = row
    Instance.new("UICorner").Parent = box

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0.08, 0, 0.7, 0)
    minus.Position = UDim2.new(0.44, 0, 0.15, 0)
    minus.Text = "−"
    minus.TextColor3 = Color3.new(1,1,1)
    minus.BackgroundColor3 = Color3.fromRGB(55,55,75)
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 16
    minus.Parent = row
    Instance.new("UICorner").Parent = minus
    minus.MouseEnter:Connect(function() minus.BackgroundColor3 = Color3.fromRGB(70,70,90) end)
    minus.MouseLeave:Connect(function() minus.BackgroundColor3 = Color3.fromRGB(55,55,75) end)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0.08, 0, 0.7, 0)
    plus.Position = UDim2.new(0.76, 0, 0.15, 0)
    plus.Text = "+"
    plus.TextColor3 = Color3.new(1,1,1)
    plus.BackgroundColor3 = Color3.fromRGB(55,55,75)
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 16
    plus.Parent = row
    Instance.new("UICorner").Parent = plus
    plus.MouseEnter:Connect(function() plus.BackgroundColor3 = Color3.fromRGB(70,70,90) end)
    plus.MouseLeave:Connect(function() plus.BackgroundColor3 = Color3.fromRGB(55,55,75) end)

    local function updateValue(newVal)
        local clamped = math.clamp(newVal, minVal, maxVal)
        clamped = math.floor(clamped / step + 0.5) * step
        if valueType == "integer" then clamped = math.floor(clamped)
        else clamped = math.round(clamped * 100) / 100 end
        box.Text = tostring(clamped)
        callback(clamped)
    end

    minus.MouseButton1Click:Connect(function()
        local val = tonumber(box.Text) or 0
        updateValue(val - step)
    end)
    plus.MouseButton1Click:Connect(function()
        local val = tonumber(box.Text) or 0
        updateValue(val + step)
    end)
    box.FocusLost:Connect(function(enter)
        if enter then
            local val = tonumber(box.Text)
            if val then updateValue(val) else box.Text = tostring(defaultValue) end
        end
    end)
end

local function createToggleRow(parent, labelText, yPos, defaultValue, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -5, 0, 32)
    row.Position = UDim2.new(0, 2, 0, yPos)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(0.9,0.9,1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.15, 0, 0.7, 0)
    btn.Position = UDim2.new(0.7, 0, 0.15, 0)
    btn.Text = defaultValue and "ВКЛ" or "ВЫКЛ"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = defaultValue and Color3.fromRGB(70,200,70) or Color3.fromRGB(200,70,70)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = row
    Instance.new("UICorner").Parent = btn
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = btn.BackgroundColor3 == Color3.fromRGB(70,200,70) and Color3.fromRGB(90,220,90) or Color3.fromRGB(220,90,90)
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = btn.Text == "ВКЛ" and Color3.fromRGB(70,200,70) or Color3.fromRGB(200,70,70)
    end)

    btn.MouseButton1Click:Connect(function()
        local newState = not (btn.Text == "ВКЛ")
        btn.Text = newState and "ВКЛ" or "ВЫКЛ"
        btn.BackgroundColor3 = newState and Color3.fromRGB(70,200,70) or Color3.fromRGB(200,70,70)
        callback(newState)
    end)
end

local function createButton(parent, labelText, yPos, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -5, 0, 32)
    row.Position = UDim2.new(0, 2, 0, yPos)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.6, 0, 0.7, 0)
    btn.Position = UDim2.new(0.2, 0, 0.15, 0)
    btn.Text = labelText
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = Color3.fromRGB(70,70,120)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = row
    Instance.new("UICorner").Parent = btn
    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(90,90,150) end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(70,70,120) end)
    btn.MouseButton1Click:Connect(callback)
end

local function createDropdown(parent, labelText, yPos, items, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -5, 0, 32)
    row.Position = UDim2.new(0, 2, 0, yPos)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(0.9,0.9,1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local dropdown = Instance.new("TextButton")
    dropdown.Size = UDim2.new(0.35, 0, 0.7, 0)
    dropdown.Position = UDim2.new(0.5, 0, 0.15, 0)
    dropdown.Text = default or "Выберите"
    dropdown.TextColor3 = Color3.new(1,1,1)
    dropdown.BackgroundColor3 = Color3.fromRGB(60,60,80)
    dropdown.Font = Enum.Font.Gotham
    dropdown.TextSize = 12
    dropdown.Parent = row
    Instance.new("UICorner").Parent = dropdown

    local menu = Instance.new("Frame")
    menu.Size = UDim2.new(0.35, 0, 0, 0)
    menu.Position = UDim2.new(0.5, 0, 1, 2)
    menu.BackgroundColor3 = Color3.fromRGB(40,40,60)
    menu.Visible = false
    menu.Parent = row
    Instance.new("UICorner").Parent = menu

    local function updateItems()
        for _, child in ipairs(menu:GetChildren()) do child:Destroy() end
        for _, item in ipairs(items) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 26)
            btn.Text = (type(item) == "string") and item or item.Name
            btn.TextColor3 = Color3.new(1,1,1)
            btn.BackgroundColor3 = Color3.fromRGB(50,50,70)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            btn.Parent = menu
            btn.MouseButton1Click:Connect(function()
                dropdown.Text = btn.Text
                menu.Visible = false
                menu.Size = UDim2.new(0.35, 0, 0, 0)
                callback(item)
            end)
        end
        local count = #items
        menu.Size = UDim2.new(0.35, 0, 0, count * 26 + 5)
    end

    dropdown.MouseButton1Click:Connect(function()
        menu.Visible = not menu.Visible
        if menu.Visible then updateItems() end
    end)
    return dropdown
end

local function addToContainer(tabId, builder)
    local data = tabContainers[tabId]
    if not data then return end
    local y = data.currentY
    local newY = builder(data.inner, y)
    data.currentY = newY or y
    data.scroll.CanvasSize = UDim2.new(0, 0, 0, data.currentY + 20)
end

-- ===== ЗАПОЛНЯЕМ ВКЛАДКИ =====
-- Player
addToContainer("Player", function(parent, y)
    createNumberRow(parent, getText("walkSpeed"), y, 0, 100, 1, DEFAULT_WALK, "integer", function(v) currentWalk = v; applyPlayerSettings() end)
    y = y + 38
    createNumberRow(parent, getText("jumpPower"), y, 0, 200, 1, DEFAULT_JUMP, "integer", function(v) currentJump = v; applyPlayerSettings() end)
    y = y + 38
    createNumberRow(parent, getText("scale"), y, 0.1, 5, 0.05, DEFAULT_SCALE, "number", function(v) currentScale = v; applyPlayerSettings() end)
    y = y + 38
    createToggleRow(parent, getText("invisible"), y, DEFAULT_INVISIBLE, function(s) isInvisible = s; applyPlayerSettings() end)
    y = y + 38
    createToggleRow(parent, getText("fly"), y, false, function(s) flyEnabled = s; if s then startFly() else stopFly() end end)
    y = y + 38
    createNumberRow(parent, getText("flySpeed"), y, 1, 50, 0.5, flySpeed, "number", function(v) flySpeed = v end)
    y = y + 38
    createToggleRow(parent, getText("flyAnim"), y, false, function(s) flyAnimation = s end)
    y = y + 38
    createToggleRow(parent, getText("infinityJump"), y, false, function(s) infinityJump = s; applyPlayerSettings() end)
    y = y + 38
    createToggleRow(parent, getText("noclip"), y, false, function(s) noclipEnabled = s; updateNoclip() end)
    y = y + 38
    createButton(parent, getText("reset"), y, function()
        currentWalk = DEFAULT_WALK; currentJump = DEFAULT_JUMP; currentScale = DEFAULT_SCALE; isInvisible = DEFAULT_INVISIBLE
        flyEnabled = false; flySpeed = 16; flyAnimation = false; infinityJump = false; noclipEnabled = false
        stopFly(); applyPlayerSettings(); updateNoclip()
    end)
    y = y + 38
    return y
end)

-- ESP
addToContainer("ESP", function(parent, y)
    createToggleRow(parent, getText("espPlayers"), y, false, function(s)
        espPlayersEnabled = s
        if s then refreshAllPlayers() else for p,h in pairs(playerHighlights) do h:Destroy(); playerHighlights[p]=nil end end
    end)
    y = y + 38
    createToggleRow(parent, getText("espGun"), y, false, function(s)
        espGunEnabled = s
        if s then scanExistingGuns() else for o,h in pairs(gunHighlights) do h:Destroy(); gunHighlights[o]=nil end end
    end)
    y = y + 38
    return y
end)

-- Visual
addToContainer("Visual", function(parent, y)
    local skyLabel = Instance.new("TextLabel")
    skyLabel.Size = UDim2.new(1, 0, 0, 28)
    skyLabel.Position = UDim2.new(0, 0, 0, y)
    skyLabel.BackgroundTransparency = 1
    skyLabel.Text = getText("skybox")
    skyLabel.TextColor3 = Color3.new(0.9,0.9,1)
    skyLabel.Font = Enum.Font.GothamBold
    skyLabel.TextSize = 14
    skyLabel.TextXAlignment = Enum.TextXAlignment.Left
    skyLabel.Parent = parent
    y = y + 32
    local skyRow = Instance.new("Frame")
    skyRow.Size = UDim2.new(1, -5, 0, 30)
    skyRow.Position = UDim2.new(0, 2, 0, y)
    skyRow.BackgroundTransparency = 1
    skyRow.Parent = parent
    local presets = {{"Default","Стандарт"},{"Sunset","Закат"},{"Night","Ночь"},{"Space","Космос"}}
    for i,p in ipairs(presets) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.22, 0, 1, 0)
        b.Position = UDim2.new(0.02 + (0.22+0.02)*(i-1), 0, 0, 0)
        b.Text = p[2]
        b.TextColor3 = Color3.new(1,1,1)
        b.BackgroundColor3 = (skyPreset == p[1]) and Color3.fromRGB(70,200,70) or Color3.fromRGB(60,60,80)
        b.Font = Enum.Font.Gotham
        b.TextSize = 9
        b.Parent = skyRow
        Instance.new("UICorner").Parent = b
        b.MouseButton1Click:Connect(function()
            skyPreset = p[1]; applySkybox(p[1])
            for _, btn in ipairs(skyRow:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.BackgroundColor3 = (btn.Text == p[2]) and Color3.fromRGB(70,200,70) or Color3.fromRGB(60,60,80)
                end
            end
        end)
    end
    y = y + 36

    local weatherLabel = Instance.new("TextLabel")
    weatherLabel.Size = UDim2.new(1, 0, 0, 28)
    weatherLabel.Position = UDim2.new(0, 0, 0, y)
    weatherLabel.BackgroundTransparency = 1
    weatherLabel.Text = getText("weather")
    weatherLabel.TextColor3 = Color3.new(0.9,0.9,1)
    weatherLabel.Font = Enum.Font.GothamBold
    weatherLabel.TextSize = 14
    weatherLabel.TextXAlignment = Enum.TextXAlignment.Left
    weatherLabel.Parent = parent
    y = y + 32
    local weatherRow = Instance.new("Frame")
    weatherRow.Size = UDim2.new(1, -5, 0, 30)
    weatherRow.Position = UDim2.new(0, 2, 0, y)
    weatherRow.BackgroundTransparency = 1
    weatherRow.Parent = parent
    local wpresets = {{"Clear","Ясно"},{"Rain","Дождь"},{"Foggy","Туман"}}
    for i,p in ipairs(wpresets) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.30, 0, 1, 0)
