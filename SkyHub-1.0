-- ===== НОВАЯ ВКЛАДКА COMBAT =====
addToContainer("Combat", function(parent, y)
    -- Заголовок "Режим"
    local modeLabel = Instance.new("TextLabel")
    modeLabel.Size = UDim2.new(1, 0, 0, 28)
    modeLabel.Position = UDim2.new(0, 0, 0, y)
    modeLabel.BackgroundTransparency = 1
    modeLabel.Text = getText("combatMode")
    modeLabel.TextColor3 = Color3.new(0.9,0.9,1)
    modeLabel.Font = Enum.Font.GothamBold
    modeLabel.TextSize = 14
    modeLabel.Parent = parent
    y = y + 32

    local modeRow = Instance.new("Frame")
    modeRow.Size = UDim2.new(1, -5, 0, 30)
    modeRow.Position = UDim2.new(0, 2, 0, y)
    modeRow.BackgroundTransparency = 1
    modeRow.Parent = parent
    local function createModeButton(text, color, xPos)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.30, 0, 1, 0)
        btn.Position = UDim2.new(xPos, 0, 0, 0)
        btn.Text = text
        btn.TextColor3 = Color3.new(1,1,1)
        btn.BackgroundColor3 = color
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 13
        btn.Parent = modeRow
        Instance.new("UICorner").Parent = btn
        return btn
    end
    local btnSheriff = createModeButton(getText("sheriff"), Color3.fromRGB(0,100,255), 0.02)
    local btnMurder = createModeButton(getText("murder"), Color3.fromRGB(255,0,0), 0.35)
    local btnInnocent = createModeButton(getText("innocent"), Color3.fromRGB(0,200,0), 0.68)
    y = y + 36

    -- Контейнеры подрежимов
    local function createSubModeContainer()
        local sub = Instance.new("Frame")
        sub.Size = UDim2.new(1, 0, 0, 0)
        sub.BackgroundTransparency = 1
        sub.Parent = parent
        return sub
    end
    local sheriffMode = createSubModeContainer()
    local murderMode = createSubModeContainer()
    local innocentMode = createSubModeContainer()
    sheriffMode.Visible = true
    murderMode.Visible = false
    innocentMode.Visible = false

    local function setCombatMode(mode)
        combatMode = mode
        sheriffMode.Visible = (mode == "Sheriff")
        murderMode.Visible = (mode == "Murder")
        innocentMode.Visible = (mode == "Innocent")
        btnSheriff.BackgroundColor3 = (mode == "Sheriff") and Color3.fromRGB(50,150,255) or Color3.fromRGB(0,100,255)
        btnMurder.BackgroundColor3 = (mode == "Murder") and Color3.fromRGB(255,50,50) or Color3.fromRGB(255,0,0)
        btnInnocent.BackgroundColor3 = (mode == "Innocent") and Color3.fromRGB(50,255,50) or Color3.fromRGB(0,200,0)
    end
    btnSheriff.MouseButton1Click:Connect(function() setCombatMode("Sheriff") end)
    btnMurder.MouseButton1Click:Connect(function() setCombatMode("Murder") end)
    btnInnocent.MouseButton1Click:Connect(function() setCombatMode("Innocent") end)
    setCombatMode("Sheriff")

    -- Sheriff Mode
    local shY = 5
    local function addSheriffRow(builder)
        local row = builder(sheriffMode, shY)
        shY = row or shY
        shY = shY + 38
    end
    addSheriffRow(function(p, y) createToggleRow(p, getText("aimbot"), y, false, function(s) sheriffAimbot = s end) return y end)
    addSheriffRow(function(p, y) createNumberRow(p, getText("aimbotFOV"), y, 1, 180, 1, sheriffFOV, "integer", function(v) sheriffFOV = v end) return y end)
    addSheriffRow(function(p, y) createNumberRow(p, getText("aimbotSmooth"), y, 1, 20, 1, sheriffSmoothness, "integer", function(v) sheriffSmoothness = v end) return y end)
    addSheriffRow(function(p, y) createToggleRow(p, getText("silentAim"), y, false, function(s) sheriffSilent = s end) return y end)
    addSheriffRow(function(p, y) createToggleRow(p, getText("triggerBot"), y, false, function(s) sheriffTrigger = s end) return y end)
    addSheriffRow(function(p, y) createToggleRow(p, getText("autoKill"), y, false, function(s) sheriffAutoKill = s end) return y end)
    addSheriffRow(function(p, y) createToggleRow(p, getText("wallHack"), y, false, function(s) sheriffWallHack = s; if s then refreshAllPlayers() else for p,h in pairs(playerHighlights) do h:Destroy(); playerHighlights[p]=nil end end end) return y end)
    addSheriffRow(function(p, y) createToggleRow(p, getText("autoShootMurder"), y, false, function(s) sheriffAutoShootMurder = s end) return y end)
    addSheriffRow(function(p, y) createButton(p, getText("flingMurderBtn"), y, function() local t=findPlayerByRole("Murder") if t then flingPlayer(t, Vector3.new(0,100,0)) end end) return y end)
    sheriffMode.Size = UDim2.new(1, 0, 0, shY + 20)

    -- Murder Mode
    local mY = 5
    local function addMurderRow(builder)
        local row = builder(murderMode, mY)
        mY = row or mY
        mY = mY + 38
    end
    addMurderRow(function(p, y) createToggleRow(p, getText("autoKillSheriff"), y, false, function(s) murderAutoKillSheriff = s end) return y end)
    addMurderRow(function(p, y) createButton(p, getText("killAll"), y, function() killAllPlayers() end) return y end)
    addMurderRow(function(p, y) createToggleRow(p, getText("autoKillAll"), y, false, function(s) murderAutoKillAll = s end) return y end)
    addMurderRow(function(p, y) createButton(p, getText("flingSheriffBtn"), y, function() local t=findPlayerByRole("Sheriff") if t then flingPlayer(t, Vector3.new(0,100,0)) end end) return y end)
    addMurderRow(function(p, y) createButton(p, getText("flingAllBtn"), y, function() flingAllPlayers(Vector3.new(0,100,0)) end) return y end)
    addMurderRow(function(p, y) createToggleRow(p, getText("knifeAimbot"), y, false, function(s) murderKnifeAimbot = s end) return y end)
    addMurderRow(function(p, y) createToggleRow(p, getText("knifeAnim"), y, false, function(s) murderKnifeAnim = s end) return y end)
    addMurderRow(function(p, y) createToggleRow(p, getText("fakeSheriff"), y, false, function(s) murderFakeSheriff = s end) return y end)
    addMurderRow(function(p, y)
        local dd = createDropdown(p, getText("killSelected"), y, getOtherPlayers(), "Выберите игрока", function(pl)
            murderSelectedPlayer = pl
            killPlayer(pl)
        end)
        return y
    end)
    murderMode.Size = UDim2.new(1, 0, 0, mY + 20)

    -- Innocent Mode
    local iY = 5
    local function addInnocentRow(builder)
        local row = builder(innocentMode, iY)
        iY = row or iY
        iY = iY + 38
    end
    addInnocentRow(function(p, y) createToggleRow(p, getText("godMode"), y, false, function(s) innocentGodMode = s; applyPlayerSettings() end) return y end)
    innocentMode.Size = UDim2.new(1, 0, 0, iY + 20)

    return y + 20
end)

-- ===== ЦИКЛ ДЛЯ COMBAT (запускается в Heartbeat) =====
local combatLoop = RunService.Heartbeat:Connect(function()
    -- Sheriff Aimbot
    if sheriffAimbot then
        local target = findClosestPlayer("Murder")
        if target then aimbot(target) end
    end
    -- Sheriff Trigger Bot
    if sheriffTrigger then
        local target = findClosestPlayer("Murder")
        if target then
            local camera = workspace.CurrentCamera
            if camera then
                local char = target.Character
                if char then
                    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if head then
                        local pos, onScreen = camera:WorldToScreenPoint(head.Position)
                        if onScreen then
                            local screenSize = camera.ViewportSize
                            local center = Vector2.new(screenSize.X/2, screenSize.Y/2)
                            if (Vector2.new(pos.X, pos.Y) - center).Magnitude < 50 then
                                triggerBot()
                            end
                        end
                    end
                end
            end
        end
    end
    -- Sheriff Auto Kill
    if sheriffAutoKill then
        local target = findClosestPlayer("Murder")
        if target then killPlayer(target) end
    end
    -- Sheriff Auto Shoot Murder
    if sheriffAutoShootMurder then
        local target = findClosestPlayer("Murder")
        if target then
            local mouse = game:GetService("Players").LocalPlayer:GetMouse()
            if mouse then mouse:Button1Down(); task.wait(0.05); mouse:Button1Up() end
        end
    end
    -- Murder Auto Kill Sheriff
    if murderAutoKillSheriff then
        local target = findPlayerByRole("Sheriff")
        if target then killPlayer(target) end
    end
    -- Murder Auto Kill All
    if murderAutoKillAll then
        for _, p in ipairs(getOtherPlayers()) do killPlayer(p) end
    end
end)

-- Остановка цикла при выключении скрипта
task.spawn(function()
    while wait(1) do
        if not gui then combatLoop:Disconnect() break end
    end
end)

-- ===== ЛОГИКА ВКЛАДОК =====
function setActiveTab(tabId)
    activeTab = tabId
    for id, data in pairs(tabContainers) do
        data.container.Visible = (id == tabId)
    end
    for id, btn in pairs(tabButtons) do
        if id == tabId then
            btn.BackgroundColor3 = Color3.fromRGB(70,60,130)
            btn.TextColor3 = Color3.new(1,1,1)
        else
            btn.BackgroundColor3 = Color3.fromRGB(40,40,60)
            btn.TextColor3 = Color3.new(0.8,0.8,0.9)
        end
    end
end

-- ===== СОХРАНЕНИЕ ПОЗИЦИЙ =====
local function savePositions()
    local myChar = LocalPlayer.Character
    if myChar then
        local root = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
        if root then lobbyPosition = root.CFrame end
    end
    local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Baseplate")
    if map and map:IsA("BasePart") then
        mapPosition = map.CFrame
    else
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and part.Size.Magnitude > 20 then
                mapPosition = part.CFrame
                break
            end
        end
    end
end

-- ===== СВОРАЧИВАНИЕ =====
closeBtn.MouseButton1Click:Connect(function()
    frame.Visible = false
    iconButton.Visible = true
end)
iconButton.MouseButton1Click:Connect(function()
    iconButton.Visible = false
    frame.Visible = true
end)

-- ===== НАДПИСЬ АВТОРА =====
local creditLabel = Instance.new("TextLabel")
creditLabel.Size = UDim2.new(1, -130, 0, 20)
creditLabel.Position = UDim2.new(0, 120, 1, -24)
creditLabel.BackgroundTransparency = 1
creditLabel.Text = getText("credit")
creditLabel.TextColor3 = Color3.fromRGB(150,140,180)
creditLabel.Font = Enum.Font.Gotham
creditLabel.TextSize = 12
creditLabel.TextXAlignment = Enum.TextXAlignment.Center
creditLabel.Parent = frame

-- ===== ОБРАБОТЧИКИ =====
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.3)
    applyPlayerSettings()
    applyCharacterColor(characterColor)
    updateGlow()
    setupInvisibilityTracker(char)
    if flyEnabled then startFly() end
    if noclipEnabled then updateNoclip() end
    if headlessEnabled then toggleHeadless(true) end
    if korbloxEnabled then toggleKorblox(true) end
    savePositions()
end)

if LocalPlayer.Character then
    setupInvisibilityTracker(LocalPlayer.Character)
    savePositions()
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.3)
        updatePlayerHighlight(p)
    end)
    if espPlayersEnabled then
        task.wait(0.5)
        updatePlayerHighlight(p)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if playerHighlights[p] then
        playerHighlights[p]:Destroy()
        playerHighlights[p] = nil
    end
end)

workspace.DescendantAdded:Connect(function(o)
    if espGunEnabled then updateGunHighlight(o) end
end)

applySkybox(skyPreset)
applyWeather(weatherPreset)
applyTimeOfDay(timeOfDay)
task.wait(0.5)
applyPlayerSettings()
applyCharacterColor(characterColor)
updateGlow()

print("SkyHub Premium (с Combat) загружен! By dont16383")
