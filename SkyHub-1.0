        b.TextColor3 = Color3.new(1,1,1)
        b.BackgroundColor3 = (menuLanguage == code) and Color3.fromRGB(70,200,70) or Color3.fromRGB(60,60,80)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.Parent = langRow
        Instance.new("UICorner").Parent = b
        b.MouseButton1Click:Connect(function()
            menuLanguage = code
        end)
        return b
    end
    langBtn("Русский", "ru", 0.02)
    langBtn("English", "en", 0.24)
    y = y + 36

    local sizeLabel = Instance.new("TextLabel")
    sizeLabel.Size = UDim2.new(1, 0, 0, 28)
    sizeLabel.Position = UDim2.new(0, 0, 0, y)
    sizeLabel.BackgroundTransparency = 1
    sizeLabel.Text = getText("settingsSize")
    sizeLabel.TextColor3 = Color3.new(0.9,0.9,1)
    sizeLabel.Font = Enum.Font.GothamBold
    sizeLabel.TextSize = 14
    sizeLabel.TextXAlignment = Enum.TextXAlignment.Left
    sizeLabel.Parent = parent
    y = y + 32
    local sizeRow = Instance.new("Frame")
    sizeRow.Size = UDim2.new(1, -5, 0, 30)
    sizeRow.Position = UDim2.new(0, 2, 0, y)
