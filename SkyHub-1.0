        b.Text = p[2]
        b.TextColor3 = Color3.new(1,1,1)
        b.BackgroundColor3 = (weatherPreset == p[1]) and Color3.fromRGB(70,200,70) or Color3.fromRGB(60,60,80)
        b.Font = Enum.Font.Gotham
        b.TextSize = 9
        b.Parent = weatherRow
        Instance.new("UICorner").Parent = b
        b.MouseButton1Click:Connect(function()
            weatherPreset = p[1]; applyWeather(p[1])
            for _, btn in ipairs(weatherRow:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.BackgroundColor3 = (btn.Text == p[2]) and Color3.fromRGB(70,200,70) or Color3.fromRGB(60,60,80)
                end
            end
        end)
    end
    y = y + 36

    createNumberRow(parent, getText("time"), y, 0, 24, 0.5, timeOfDay, "number", function(v) timeOfDay = v; applyTimeOfDay(v) end)
    y = y + 38

    local colorLabel = Instance.new("TextLabel")
    colorLabel.Size = UDim2.new(1, 0, 0, 28)
