local function createNumberRow(parent, labelText, yPos, minVal, maxVal, step, defaultValue, valueType, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -5, 0, 32)
    row.Position = UDim2.new(0, 2, 0, yPos)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(0.9, 0.9, 1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.1, 0, 0.7, 0)
    box.Position = UDim2.new(0.58, 0, 0.15, 0)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.Text = tostring(defaultValue)
    box.ClearTextOnFocus = false
    box.Parent = row
    Instance.new("UICorner").Parent = box

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0.08, 0, 0.7, 0)
    minus.Position = UDim2.new(0.44, 0, 0.15, 0)
    minus.Text = "−"
    minus.TextColor3 = Color3.new(1, 1, 1)
    minus.BackgroundColor3 = Color3.fromRGB(55, 55, 75)
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 16
    minus.Parent = row
    Instance.new("UICorner").Parent = minus
    minus.MouseEnter:Connect(function() minus.BackgroundColor3 = Color3.fromRGB(70, 70, 90) end)
    minus.MouseLeave:Connect(function() minus.BackgroundColor3 = Color3.fromRGB(55, 55, 75) end)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0.08, 0, 0.7, 0)
    plus.Position = UDim2.new(0.76, 0, 0.15, 0)
    plus.Text = "+"
    plus.TextColor3 = Color3.new(1, 1, 1)
    plus.BackgroundColor3 = Color3.fromRGB(55, 55, 75)
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 16
    plus.Parent = row
    Instance.new("UICorner").Parent = plus
    plus.MouseEnter:Connect(function() plus.BackgroundColor3 = Color3.fromRGB(70, 70, 90) end)
    plus.MouseLeave:Connect(function() plus.BackgroundColor3 = Color3.fromRGB(55, 55, 75) end)

    local function updateValue(newVal)
        local clamped = math.clamp(newVal, minVal, maxVal)
        clamped = math.floor(clamped / step + 0.5) * step
        if valueType == "integer" then clamped = math.floor(clamped)
        else clamped = math.round(clamped * 100) / 100 end
        box.Text = tostring(clamped)
        callback(clamped)
    end

    minus.MouseButton1Click:Connect(function()
        local val = tonumber(box.Text) or 0
        updateValue(val - step)
    end)
    plus.MouseButton1Click:Connect(function()
        local val = tonumber(box.Text) or 0
        updateValue(val + step)
    end)
    box.FocusLost:Connect(function(enter)
        if enter then
            local val = tonumber(box.Text)
            if val then updateValue(val) else box.Text = tostring(defaultValue) end
        end
    end)
end

