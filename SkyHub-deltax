-- ===== ESP ФУНКЦИИ (без изменений) =====
local function getPlayerRole(player)
    if player == LocalPlayer then return nil end
    if player.Team then
        local n = player.Team.Name
        if n == "Murderer" or n == "Murder" then return "Murder"
        elseif n == "Sheriff" or n == "Sheriffs" then return "Sheriff"
        else return "Innocent" end
    end
    if player.TeamColor then
        local col = player.TeamColor.Color
        if col == Color3.new(1,0,0) then return "Murder"
        elseif col == Color3.new(0,0,1) then return "Sheriff"
        else return "Innocent" end
    end
    return "Innocent"
end

local function updatePlayerHighlight(player)
    if player == LocalPlayer then return end
    if not espPlayersEnabled then
        if playerHighlights[player] then
            playerHighlights[player]:Destroy()
            playerHighlights[player] = nil
        end
        return
    end
    local ch = player.Character
    if not ch then return end
    if playerHighlights[player] then
        playerHighlights[player]:Destroy()
        playerHighlights[player] = nil
    end
    local role = getPlayerRole(player)
    local fc
    if role == "Murder" then fc = Color3.new(1,0,0)
    elseif role == "Sheriff" then fc = Color3.new(0,0,1)
    else fc = Color3.new(0,1,0) end
    local hl = Instance.new("Highlight")
    hl.Parent = ch
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = fc
    hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    playerHighlights[player] = hl
end

local function refreshAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do updatePlayerHighlight(p) end
end

local function updateGunHighlight(obj)
    if not espGunEnabled then
        if gunHighlights[obj] then gunHighlights[obj]:Destroy(); gunHighlights[obj] = nil end
        return
    end
    if obj:IsA("Tool") or obj:IsA("Model") then
        local n = obj.Name:lower()
        if n:find("gun") or n:find("pistol") or n:find("weapon") then
            local par = obj.Parent
            if par and par:FindFirstChild("Humanoid") then return end
            if obj:IsDescendantOf(workspace) and not obj:IsDescendantOf(LocalPlayer.Character) then
                if gunHighlights[obj] then gunHighlights[obj]:Destroy(); gunHighlights[obj] = nil end
                local hl = Instance.new("Highlight")
                hl.Parent = obj
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillColor = Color3.new(1,1,0)
                hl.OutlineColor = Color3.new(1,1,0)
                hl.FillTransparency = 0.3
                hl.OutlineTransparency = 0
                gunHighlights[obj] = hl
            end
        end
    end
end

local function scanExistingGuns()
    for _, o in ipairs(workspace:GetDescendants()) do updateGunHighlight(o) end
end

