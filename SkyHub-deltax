-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (те же) =====
local function getHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("Humanoid")
end

local function getRootPart()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function updateInvisibility(part)
    if part:IsA("BasePart") then
        part.Transparency = isInvisible and 1 or 0
    end
end

local function applyPlayerSettings()
    local humanoid = getHumanoid()
    if not humanoid then return end
    humanoid.WalkSpeed = currentWalk
    if infinityJump then
        humanoid.JumpPower = 9999
    else
        humanoid.JumpPower = currentJump
    end
    humanoid.Scale = currentScale

    if innocentGodMode and humanoid then
        humanoid.MaxHealth = 9e9
        humanoid.Health = 9e9
        humanoid.BreakJointsOnDeath = false
    else
        humanoid.MaxHealth = 100
        humanoid.BreakJointsOnDeath = true
    end

    local char = LocalPlayer.Character
    if not char then return end
    for _, child in ipairs(char:GetDescendants()) do
        updateInvisibility(child)
    end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Hat") then
            for _, part in ipairs(child:GetDescendants()) do
                updateInvisibility(part)
            end
        end
    end
end

local function setupInvisibilityTracker(character)
    local connection
    connection = character.DescendantAdded:Connect(function(part)
        if isInvisible then
            updateInvisibility(part)
        end
    end)
    character._invisConnection = connection
end

-- ===== ЛОГИКА ПОЛЁТА (без изменений) =====
local function startFly()
    local root = getRootPart()
    local humanoid = getHumanoid()
    if not root or not humanoid then return end

    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 10000
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 10000
    flyBodyGyro.CFrame = root.CFrame
    flyBodyGyro.Parent = root

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    if flyConnection then flyConnection:Disconnect() end
    flyConnection = RunService.Heartbeat:Connect(function(dt)
        updateFly(dt)
    end)
end

local function stopFly()
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end

    local humanoid = getHumanoid()
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
    end
end

local function updateFly(dt)
    if not flyEnabled then return end
    local root = getRootPart()
    local humanoid = getHumanoid()
    if not root or not humanoid then return end

    local camera = workspace.CurrentCamera
    if not camera then return end
    local camCF = camera.CFrame
    local forward = camCF.LookVector * Vector3.new(1, 0, 1)
    if forward.Magnitude < 0.1 then forward = Vector3.new(1, 0, 0) end
    forward = forward.Unit
    local right = camCF.RightVector * Vector3.new(1, 0, 1)
    if right.Magnitude < 0.1 then right = Vector3.new(1, 0, 0) end
    right = right.Unit
    local up = Vector3.new(0, 1, 0)

    local moveVector = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        moveVector = moveVector + forward
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        moveVector = moveVector - forward
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        moveVector = moveVector - right
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        moveVector = moveVector + right
    end

    local vertical = 0
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        vertical = 1
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        vertical = -1
    end

    if moveVector.Magnitude > 0 then
        moveVector = moveVector.Unit * flySpeed
    end
    local verticalSpeed = vertical * flySpeed * 0.8

    local velocity = moveVector + up * verticalSpeed
    if flyBodyVelocity then
        flyBodyVelocity.Velocity = velocity
    end

    if flyBodyGyro and moveVector.Magnitude > 0.1 then
        local look = CFrame.lookAt(root.Position, root.Position + moveVector)
        flyBodyGyro.CFrame = look
    elseif flyBodyGyro then
        flyBodyGyro.CFrame = CFrame.new(root.Position, root.Position + forward)
    end

    if flyAnimation then
        flyPulse = flyPulse + dt * 2
        local wave = math.sin(flyPulse) * 0.3
        if flyBodyVelocity then
            flyBodyVelocity.Velocity = flyBodyVelocity.Velocity + Vector3.new(0, wave * 0.5, 0)
        end
    end
end

