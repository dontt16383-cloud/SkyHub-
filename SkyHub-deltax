local function createDropdown(parent, labelText, yPos, items, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -5, 0, 32)
    row.Position = UDim2.new(0, 2, 0, yPos)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(0.9, 0.9, 1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local dropdown = Instance.new("TextButton")
    dropdown.Size = UDim2.new(0.35, 0, 0.7, 0)
    dropdown.Position = UDim2.new(0.5, 0, 0.15, 0)
    dropdown.Text = default or "Выберите"
    dropdown.TextColor3 = Color3.new(1, 1, 1)
    dropdown.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    dropdown.Font = Enum.Font.Gotham
    dropdown.TextSize = 12
    dropdown.Parent = row
    Instance.new("UICorner").Parent = dropdown

    local menu = Instance.new("Frame")
    menu.Size = UDim2.new(0.35, 0, 0, 0)
    menu.Position = UDim2.new(0.5, 0, 1, 2)
    menu.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    menu.Visible = false
    menu.Parent = row
    Instance.new("UICorner").Parent = menu

    local function updateItems()
        for _, child in ipairs(menu:GetChildren()) do child:Destroy() end
        for _, item in ipairs(items) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 26)
            btn.Text = item.Name or item
            btn.TextColor3 = Color3.new(1,1,1)
            btn.BackgroundColor3 = Color3.fromRGB(50,50,70)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            btn.Parent = menu
            btn.MouseButton1Click:Connect(function()
                dropdown.Text = btn.Text
                menu.Visible = false
                menu.Size = UDim2.new(0.35, 0, 0, 0)
                callback(item)
            end)
        end
        menu.Size = UDim2.new(0.35, 0, 0, #items * 26 + 5)
    end

    dropdown.MouseButton1Click:Connect(function()
        menu.Visible = not menu.Visible
        if menu.Visible then
            updateItems()
        end
    end)

    return dropdown
end

