-- Запуск Combat Loop (аимбот и триггеры)
local combatLoop = RunService.Heartbeat:Connect(function()
    -- Sheriff Aimbot
    if sheriffAimbot then
        local target = findPlayerByRole("Murder")
        if target then aimbot(target) end
    end
    -- Sheriff Trigger Bot
    if sheriffTrigger then
        local target = findPlayerByRole("Murder")
        if target then
            local camera = workspace.CurrentCamera
            if camera then
                local char = target.Character
                if char then
                    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if head then
                        local pos, onScreen = camera:WorldToScreenPoint(head.Position)
                        if onScreen then
                            local screenSize = camera.ViewportSize
                            local center = Vector2.new(screenSize.X/2, screenSize.Y/2)
                            if (Vector2.new(pos.X, pos.Y) - center).Magnitude < 50 then
                                triggerBot()
                            end
                        end
                    end
                end
            end
        end
    end
    -- Sheriff Auto Kill
    if sheriffAutoKill then
        local target = findPlayerByRole("Murder")
        if target then killPlayer(target) end
    end
    -- Sheriff Auto Shoot Murder
    if sheriffAutoShootMurder then
        local target = findPlayerByRole("Murder")
        if target then
            local mouse = game:GetService("Players").LocalPlayer:GetMouse()
            if mouse then mouse:Button1Down(); task.wait(0.05); mouse:Button1Up() end
        end
    end
    -- Murder Auto Kill Sheriff
    if murderAutoKillSheriff then
        local target = findPlayerByRole("Sheriff")
        if target then killPlayer(target) end
    end
    -- Murder Auto Kill All
    if murderAutoKillAll then
        for _, p in ipairs(getOtherPlayers()) do killPlayer(p) end
    end
end)

