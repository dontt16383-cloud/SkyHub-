-- Для удобства создадим функцию добавления элементов с авто-расширением CanvasSize
local function addToContainer(tabId, builderFunc)
    local data = tabContainers[tabId]
    if not data then return end
    local parent = data.inner
    local yPos = 0
    -- мы будем передавать yPos и возвращать новую позицию после добавления
    -- но для простоты мы будем использовать глобальный счётчик y для каждой вкладки
    -- создадим таблицу с текущими y
    if not data.currentY then data.currentY = 5 end
    yPos = data.currentY
    local newY = builderFunc(parent, yPos)
    data.currentY = newY or yPos
    -- обновляем CanvasSize
    data.scroll.CanvasSize = UDim2.new(0, 0, 0, data.currentY + 20)
end

