-- Получить всех игроков (кроме себя)
local function getOtherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end
    return list
end

-- Найти игрока по роли
local function findPlayerByRole(role)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getPlayerRole(p) == role then
            return p
        end
    end
    return nil
end

-- Телепорт к игроку
local function teleportToPlayer(player)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not root then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
    if myRoot then
        myRoot.CFrame = root.CFrame + Vector3.new(0, 3, 0) -- чуть выше, чтобы не заспавниться внутри
    end
end

-- Телепорт в лобби (сохраняем позицию при старте)
local function teleportToLobby()
    if lobbyPosition then
        local myChar = LocalPlayer.Character
        if myChar then
            local root = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
            if root then
                root.CFrame = lobbyPosition
            end
        end
    end
end

-- Телепорт на карту (центр карты)
local function teleportToMap()
    if mapPosition then
        local myChar = LocalPlayer.Character
        if myChar then
            local root = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
            if root then
                root.CFrame = mapPosition
            end
        end
    else
        -- Если не нашли, попробуем найти объект "Map" или "Baseplate"
        local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Baseplate")
        if map and map:IsA("BasePart") then
            mapPosition = map.CFrame
            teleportToMap()
        end
    end
end

-- Флинг (отбросить) игрока
local function flingPlayer(player, force)
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        if root then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1,1,1) * 10000
            bv.Velocity = force
            bv.Parent = root
            task.wait(0.3)
            bv:Destroy()
        end
    end
end

-- Флинг всех
local function flingAllPlayers(force)
    for _, p in ipairs(getOtherPlayers()) do
        flingPlayer(p, force)
    end
end

