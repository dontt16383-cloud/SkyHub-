local function applySkybox(preset)
    skyPreset = preset
    local sky = Lighting:FindFirstChild("Sky") or Instance.new("Sky")
    sky.Parent = Lighting
    if preset == "Default" then
        sky.SkyboxBk = "rbxasset://textures/sky/skybox/skyBk.tex"
        sky.SkyboxDn = "rbxasset://textures/sky/skybox/skyDn.tex"
        sky.SkyboxFt = "rbxasset://textures/sky/skybox/skyFt.tex"
        sky.SkyboxLf = "rbxasset://textures/sky/skybox/skyLf.tex"
        sky.SkyboxRt = "rbxasset://textures/sky/skybox/skyRt.tex"
        sky.SkyboxUp = "rbxasset://textures/sky/skybox/skyUp.tex"
    elseif preset == "Sunset" then
        for _, dir in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do
            sky["Skybox"..dir] = "rbxassetid://189338394"
        end
    elseif preset == "Night" then
        for _, dir in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do
            sky["Skybox"..dir] = "rbxassetid://189338466"
        end
    elseif preset == "Space" then
        for _, dir in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do
            sky["Skybox"..dir] = "rbxassetid://189338532"
        end
    end
end

local function applyWeather(preset)
